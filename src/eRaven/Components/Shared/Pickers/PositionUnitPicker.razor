@using eRaven.Application.DTOs
@using Microsoft.AspNetCore.Components

<div class="picker">
    <label class="form-label mb-1">@Label</label>

    <div class="input-group">
        <input class="form-control rounded-0"
               placeholder="Пошук: код / коротка / частина повної назви..."
               value="@_search"
               @oninput="OnSearchInput" />

        <Button Class="btn-outline-secondary rounded-0"
                Label="Очистити"
                IsDisabled="@(!HasSelection)"
                OnClickButton="Clear"/>
    </div>

    <div class="picker-results mt-2 border">
        @if (Items is null || Items.Count == 0)
        {
            <div class="p-2 small text-muted">Немає вакансій.</div>
        }
        else if (_filtered.Count == 0)
        {
            <div class="p-2 small text-muted">Нічого не знайдено.</div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 18%">Код</th>
                        <th>Коротка</th>
                        <th style="width: 18%">Звання</th>
                        <th style="width: 12%">Тариф</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in _filtered)
                    {
                        <tr class="@RowClass(p)"
                            @onclick="() => Select(p)">
                            <td class="text-nowrap">@p.Code</td>
                            <td class="text-truncate" title="@p.FullName">@p.ShortName</td>
                            <td class="text-nowrap">@p.Rank</td>
                            <td class="text-nowrap">@p.Tarif</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_selected is not null && !string.IsNullOrWhiteSpace(_selected.FullName))
    {
        <div class="small text-muted mt-2 picker-preview"
             title="@_selected.FullName">
            <span class="fw-semibold">Повна назва:</span> @_selected.FullName
        </div>
    }

    @if (For is not null)
    {
        <ValidationMessage For="@For" />
    }
</div>
