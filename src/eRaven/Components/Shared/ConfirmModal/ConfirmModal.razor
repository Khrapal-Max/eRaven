@typeparam T

@if (Visible)
{
    <div class="modal fade show" style="display:block;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered @DialogSize">
            <div class="modal-content">

                <div class="modal-header py-2">
                    <h6 class="modal-title">@Title</h6>
                </div>

                <div class="modal-body">
                    @if (BodyTemplate is not null)
                    {
                        @BodyTemplate(_model!)
                    }
                    else if (!string.IsNullOrWhiteSpace(BodyText))
                    {
                        <p class="mb-0">@BodyText</p>
                    }
                    else
                    {
                        <p class="mb-0">Підтвердити дію?</p>
                    }
                </div>

                <div class="modal-footer py-2">
                    <ButtonComponent Class="btn-sm btn-secondary"
                                     Label="@CancelText"
                                     OnClickButton="Cancel"/>
                    <ButtonComponent Class="btn-sm btn-danger"
                                     Label="@ConfirmText"
                                     OnClickButton="Confirm" />
                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}
