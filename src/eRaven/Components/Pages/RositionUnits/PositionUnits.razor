@page "/position-units"
@using eRaven.Domain.Entities
@using Microsoft.AspNetCore.Components.Forms
@using eRaven.Domain.Enums

<div class="page-flex">
    <PageToolbar Title="Довідник посад для штатного розкладу">
        <Right>
            <PositionUnitImportExport OnChanged="LoadAsync" />
            <Button Class="btn-primary rounded-0 border-0" 
                    Label="Додати"
                    OnClickButton="OnAddPositionUnitClick" />
        </Right>
    </PageToolbar>

    <div class="page-content">
        @if (IsLoading)
        {
            <p class="px-3"><em>Завантаження...</em></p>
        }
        else if (PositionUnitsList.Count == 0)
        {
            <p class="px-3"><em>Записи відсутні.</em></p>
        }
        else
        {
            <Table Items="@PositionUnitsList"
                   TItem="PositionUnit"
                   KeySelector="x => x.Id"
                   @bind-SelectedItem="Selected">
                <TableHeader>
                    <th>#</th>
                    <th>Код.</th>
                    <th>Назва посади</th>
                    <th>Повна посада</th>
                    <th>ВОС</th>
                    <th>Стан</th>
                    <th>ШПК</th>
                    <th>ТР</th>
                    <th class="text-center">Статус</th>
                    <th class="text-center">Дія</th>
                </TableHeader>

                <RowTemplate Context="unit">
                    <td>@unit.Number</td>
                    <td>@unit.Code</td>
                    <td>@unit.ShortName</td>
                    <td>@unit.FullName</td>
                    <td>@unit.SpecialNumber</td>
                    @switch(unit.State)
                    {
                        case PositionUnitState.Vacant:
                            <td><span class="badge bg-success">Вакантна</span></td>;
                            break;
                        case PositionUnitState.Occupied:
                            <td><span class="badge bg-secondary">Не вакантна</span></td>;
                            break;
                        case PositionUnitState.TemporarilyOccupied:
                            <td><span class="badge bg-warning text-dark">Тимчасово зайнята</span></td>;
                            break;
                    }
                    <td>@unit.Rank</td>
                    <td>@unit.Tarif</td>
                    <td class="text-center">@(unit.IsActived ? "А" : "Н")</td>
                    <td class="text-center">
                        <Button Class="btn-sm btn-outline-danger"
                                Label="Закрити"
                                IsDisabled="!unit.IsActived"
                                StopPropagation="true"
                                OnClickButton="() => AskDeactivate(unit)" />
                    </td>
                </RowTemplate>
            </Table>
        }       
    </div>
    <footer class="d-flex align-items-start gap-2 px-3 border border-primary">
        <small class="fw-semibold text-nowrap">
            Бізнес-правила:
        </small>

        <small class="lh-sm">
            <em>
                1) Порядковий номер за штатним розкладом може бути активним лише у одного запису;
                2) Індекс (код) посади є унікальним значенням і не може повторюватися.
            </em>
        </small>
    </footer>
</div>

<Modal Title="Додати посаду"
       IsOpen="@CreateOpen"
       IsOpenChanged="v => CreateOpen = v"
       CreateText="Додати"
       CancelText="Відміна"
       DialogSize="modal-xl"
       OnCreateAsync="CreateAsync">

    @if (_createEditContext is not null)
    {
        <EditForm EditContext="@_createEditContext">
            <div class="row g-2">
                <div class="col-12 col-md-3">
                    <label class="form-label">Номер</label>
                    <InputNumber class="form-control" @bind-Value="CreateModel.Number" />
                    <ValidationMessage For="@(() => CreateModel.Number)" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Код</label>
                    <InputText class="form-control" @bind-Value="CreateModel.Code" />
                    <ValidationMessage For="@(() => CreateModel.Code)" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Коротка назва</label>
                    <InputText class="form-control" @bind-Value="CreateModel.ShortName" />
                    <ValidationMessage For="@(() => CreateModel.ShortName)" />
                </div>

                <div class="col-12">
                    <label class="form-label">Повна назва</label>
                    <InputText class="form-control" @bind-Value="CreateModel.FullName" />
                    <ValidationMessage For="@(() => CreateModel.FullName)" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label">ВОС</label>
                    <InputText class="form-control" @bind-Value="CreateModel.SpecialNumber" />
                    <ValidationMessage For="@(() => CreateModel.SpecialNumber)" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label">ШПК</label>

                    <div class="dropdown w-100">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-truncate"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            @(string.IsNullOrWhiteSpace(CreateModel.Rank) ? "— оберіть звання —" : CreateModel.Rank)
                        </button>

                        <ul class="dropdown-menu w-100 overflow-auto" style="max-height: 30vh;">
                            @foreach (var title in RankTitles)
                            {
                                <li>
                                    <Button Class="dropdown-item"
                                            Label="@title"
                                            OnClickButton="() => CreateModel.Rank = title" />
                                </li>
                            }
                        </ul>
                    </div>

                    <ValidationMessage For="@(() => CreateModel.Rank)" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label">Тариф</label>
                    <InputText class="form-control" @bind-Value="CreateModel.Tarif" />
                    <ValidationMessage For="@(() => CreateModel.Tarif)" />
                </div>
            </div>
        </EditForm>
    }
</Modal>

<ConfirmModal T="PositionUnit"
              @ref="_deactivateModal"
              Title="Закриття посади в штатному розкладі"
              ConfirmText="Закрити"
              CancelText="Відміна"
              DialogSize="modal-md">
    <BodyTemplate Context="u">
        <p class="mb-0">Закрити посаду <b>@u.FullName</b>?</p>
        <div class="text-muted small mt-1">Код: @u.Code • ВОС: @u.SpecialNumber</div>
    </BodyTemplate>
</ConfirmModal>
