@page "/position-units"
@using eRaven.Domain.Entities
@using eRaven.Components.Shared.ButtonComponent

<PageTitle>Посади</PageTitle>

@if (IsLoading)
{
    <p><em>Завантаження...</em></p>
}
else if (PositionUnitsList.Count == 0)
{
    <p><em>Записи відсутні.</em></p>
}
else if (PositionUnitsList.Count > 0)
{

    <TableComponent Items="@PositionUnitsList"
                    TItem="PositionUnit"
                    KeySelector="x => x.Id"
                    OnClick="OnRowClick">
        <TableHeader>
            <th>Код.</th>
            <th>Назва посади</th>
            <th>Повна посада</th>
            <th>ВОС</th>
            <th>Статус</th>
            <th>Дія</th>
        </TableHeader>
        <RowTemplate Context="unit">
            <td>@unit.Code</td>
            <td>@unit.ShortName</td>
            <td>@unit.FullName</td>
            <td>@unit.SpecialNumber</td>
            <td class="align-middle">@(unit.IsActived ? "А" : "Н")</td>
            <td class="align-middle">кноп</td>
        </RowTemplate>
    </TableComponent>
}