@using Microsoft.AspNetCore.Components.Forms
@using eRaven.Domain.Entities

<Button Class="btn-outline-secondary rounded-0 border-0"
        Label="Імпорт"
        OnClickButton="OpenImport" />

<Button Class="btn-outline-secondary rounded-0 border-0"
        Label="Експорт"
        OnClickButton="ExportAsync" />

<Modal Title="Імпорт посад (Excel)"
       IsOpen="@_importOpen"
       IsOpenChanged="v => _importOpen = v"
       CreateText="Імпортувати"
       CancelText="@(_importDone ? "Закрити" : "Відміна")"
       DialogSize="modal-xl"
       IsBusy="@(_isParsing || _isImporting)"
       OnCreateAsync="CommitImportAsync">

    <div class="d-flex flex-column gap-2">

        <InputFile OnChange="OnFileSelected"
                   accept=".xlsx"
                   disabled="@(_isParsing || _isImporting)" />

        @* ===== Parsing ===== *@
        @if (_isParsing)
        {
            <div class="alert alert-info py-2 mb-0 d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <div>Читаємо файл та виконуємо перевірки…</div>
            </div>
        }

        @* ===== Importing ===== *@
        @if (_isImporting)
        {
            <div class="alert alert-primary py-2 mb-0 d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <div>Імпорт виконується…</div>
            </div>
        }

        @* ===== Success ===== *@
        @if (_importDone)
        {
            <div class="alert alert-success py-2 mb-0">
                <div class="fw-semibold">✅ Імпорт завершено</div>
                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <div class="small">@_statusMessage</div>
                }
            </div>
        }

        @* ===== Errors / info (тільки коли НЕ parsing/importing/done) ===== *@
        @if (!_importDone
                && !_isParsing
                && !_isImporting
                && !string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert alert-secondary py-2 mb-0">
                <div class="small">@_statusMessage</div>
            </div>
        }

        @* ===== Result summary ===== *@
        @if (_importResult is not null)
        {
            <div class="small">
                Валідних: <b>@_importResult.ValidItems.Count</b>,
                Помилок: <b>@_importResult.Errors.Count</b>
            </div>

            @if (_importResult.Errors.Count > 0)
            {
                <div class="alert alert-warning py-2 mb-0">
                    <div class="fw-semibold mb-1">Є помилки у файлі:</div>
                    <ul class="mb-0">
                        @foreach (var e in _importResult.Errors.Take(10))
                        {
                            <li>
                                Рядок @e.RowNumber,
                                поле @e.Field:
                                @e.Message
                            </li>
                        }
                    </ul>

                    @if (_importResult.Errors.Count > 10)
                    {
                        <div class="small text-muted mt-1">
                            Показано 10 з @_importResult.Errors.Count
                        </div>
                    }
                </div>
            }
        }
    </div>
</Modal>
