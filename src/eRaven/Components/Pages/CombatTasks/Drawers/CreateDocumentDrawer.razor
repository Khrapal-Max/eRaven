﻿@using System.ComponentModel.DataAnnotations
@using eRaven.Components.Shared.Validation

<Drawer Title="Документ бойових завдань"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        DisableClose="@_busy"
        OnClosed="OnDrawerClosed">

    <ChildContent>
        @if (IsOpen)
        {
            <div class="drawer-grow">
                <EditForm EditContext="@_editContext" OnValidSubmit="SubmitAsync" id="document-draft-form">
                    <DataAnnotationsValidator />

                    <div class="row g-2">

                        <div class="col-12 col-md-6">
                            <label class="form-label mb-1">Назва/номер документа</label>
                            <InputText class="form-control rounded-0"
                                       @bind-Value="Model.OrderTitle"
                                       placeholder="Напр: План №12" />
                            <ValidationMessage For="@(() => Model.OrderTitle)" />
                            <div class="form-text text-black">Мінімум 2 символи.</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label mb-1">Дата документа</label>
                            <InputDate class="form-control rounded-0 bg-dark text-white"
                                       @bind-Value="Model.RecordedAt" />
                            <ValidationMessage For="@(() => Model.RecordedAt)" />
                        </div>                      


                        <div class="col-12">
                            <label class="form-label mb-1">Опис змісту</label>
                            <InputText class="form-control rounded-0"
                                       @bind-Value="Model.Description"
                                       placeholder="Напр: БЕ" />
                            <ValidationMessage For="@(() => Model.Description)" />
                        </div>
                    </div>
                </EditForm>

            </div>
        }
    </ChildContent>

    <FooterContent>
        <Button Class="btn-outline-secondary rounded-0"
                Label="Скасувати"
                IsDisabled="@_busy"
                OnClickButton="OnCancel" />

        <button type="submit"
                form="document-draft-form"
                class="btn btn-primary rounded-0"
                disabled="@DisabledSave">
            Створити
        </button>
    </FooterContent>

</Drawer>