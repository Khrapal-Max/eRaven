<Drawer IsOpen="IsOpen"
        IsOpenChanged="IsOpenChanged"
        Title="Подія табеля">

    <ChildContent>
        @if (_loading)
        {
            <div class="p-3"><em>Завантаження…</em></div>
        }
        else
        {
            <div class="border p-3 mb-3 d-flex align-items-center flex-wrap gap-2 small">
                <span class="fw-semibold">Контекст:</span>

                @if (!string.IsNullOrWhiteSpace(PersonLabel))
                {
                    <span class="text-truncate" style="max-width: 420px;">@PersonLabel</span>
                    <span class="opacity-50">•</span>
                }

                <span>
                    Стан на дату <span class="font-monospace">@_model.InputDate.ToString("yyyy-MM-dd")</span>:
                    <span class="fw-semibold fs-5">Код: @_currentCode</span>
                </span>

                <span class="opacity-50">•</span>

                <span>
                    Операційна дата: <span class="font-monospace">@OperatorDate.ToString("yyyy-MM-dd")</span>
                </span>
            </div>

            @if (_isDerived)
            {
                <div class="alert alert-light border small mb-0">
                    Стан <b>“@_currentCode”</b> є derived і не застосовується як подія. На цю дату немає активного запису табеля.
                </div>
            }
            else if (_isSystemCurrent)
            {
                <div class="alert alert-warning border small mb-0">
                    Під активним <b>system-кодом</b> ручні події заблоковані.
                </div>
            }
            else if (_transitionOptions.Count == 0 && _emergencyOptions.Count == 0)
            {
                <div class="alert alert-light border small mb-0">
                    Для поточного коду немає дозволених переходів.
                </div>
            }
            else
            {
                <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="border mb-3">
                        <div class="fw-semibold px-2">Нова подія</div>

                        <div class="row px-2 g-2">

                            <div class="col-12 col-lg-3">
                                <label class="form-label small">Дата події</label>
                                <InputDate class="form-control form-control-sm bg-dark text-white"
                                           @bind-Value="_model.InputDate"
                                           @bind-Value:after="OnInputDateChangedAsync" />
                                <ValidationMessage For="@(() => _model.InputDate)" />

                                @if (_model.InputDate < OperatorDate)
                                {
                                    <div class="small text-danger mt-1">
                                        Дата раніше операційної. Використайте персональний табель (режим корекції).
                                    </div>
                                }
                            </div>

                            <div class="col-12 col-lg-9">
                                <label class="form-label small">Наступний код</label>

                                <InputSelect class="form-select form-select-sm"
                                             TValue="Guid ?"
                                             @bind-Value="_model.CodeId"
                                             size="@SelectSize(_transitionOptions)"
                                             style="height: 220px;">
                                    @if (_transitionOptions.Count > 0)
                                    {
                                        <optgroup label="Переходи (матриця)">
                                            @foreach (var o in _transitionOptions)
                                            {
                                                <option value="@o.TransitionCodeId">@o.Code @o.Display • @ShiftLabel(o.StartShiftDays)</option>
                                            }
                                        </optgroup>
                                    }

                                    @if (_emergencyOptions.Count > 0)
                                    {
                                        <optgroup label="Аварійні коди (глобально)">
                                            @foreach (var o in _emergencyOptions)
                                            {
                                                <option value="@o.TransitionCodeId">@o.Code @o.Display</option>
                                            }
                                        </optgroup>
                                    }
                                </InputSelect>

                                <ValidationMessage For="@(() => _model.CodeId)" />

                                @if (IsEmergencySelected())
                                {
                                    <div class="small text-danger-emphasis mt-1">
                                        Обрано аварійний код: застосовується <b>з дати події</b>.
                                    </div>
                                }
                            </div>

                            <div class="col-12 col-lg-6">
                                <label class="form-label small">Підстава / референс (опціонально)</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_model.Reference" />
                            </div>

                            <div class="col-12 col-lg-6">
                                <label class="form-label small">Примітка (опціонально)</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_model.Note" />
                            </div>

                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <Button Class="btn-sm btn-success"
                                Label="@(_busy ? "Застосування…" : "Застосувати")"
                                IsDisabled="_busy || (_model.InputDate < OperatorDate)"
                                OnClickButton="SubmitAsync" />

                        <Button Class="btn-sm btn-danger"
                                Label="Скасувати"
                                IsDisabled="_busy"
                                OnClickButton="CloseAsync" />
                    </div>
                </EditForm>
            }
        }

        <div class="d-flex flex-column justify-content-start small opacity-75 mt-3">
            <div class="fw-semibold mb-1">Як система читає дату події</div>
            <ul class="mb-0 ps-3">
                <li><b>З дати події (0)</b> — новий код діє цього ж дня.</li>
                <li class="mt-1"><b>Ще поточний (1)</b> — цей день лишається за поточним кодом, новий починається з наступного дня.</li>
            </ul>

            @{
                var sel = SelectedOption();
                if (sel is not null)
                {
                    var nextFrom = _model.InputDate.AddDays(sel.StartShiftDays);
                    var prevTo = nextFrom.AddDays(-1);

                    <div class="mt-2">
                        Попередній код завершиться: <span class="font-monospace">@prevTo.ToString("yyyy-MM-dd")</span>,
                        новий код почнеться: <span class="font-monospace">@nextFrom.ToString("yyyy-MM-dd")</span>.
                    </div>
                }
            }
        </div>
    </ChildContent>
</Drawer>