@page "/timesheet-week"
@using eRaven.Application.DTOs.Timesheets

<PageTitle>Табель (тиждень)</PageTitle>

<div class="page-flex">

    <div class="page-toolbar py-2 px-3 bg-body text-white rounded-0">
        <div class="d-flex flex-wrap gap-2 align-items-center">

            <div class="me-auto min-w-0">
                <div class="fw-semibold">Операційний табель (тиждень)</div>

                <div class="small text-wrap">
                    @_fromDate.ToString("dd.MM.yyyy") — @_toDate.ToString("dd.MM.yyyy")
                    · Курсор дата: <span class="fw-semibold">@_anchorDate.ToString("dd.MM.yyyy")</span>
                    · Рядків: <span class="fw-semibold">@(_rows?.Count ?? 0)</span>
                </div>

                <div class="small opacity-75">
                    Подія створюється від <span class="fw-semibold">Поточної дати</span> (сьогодні), а корекції — у персональному табелі.
                </div>
            </div>

            <div class="btn-group btn-group-sm flex-shrink-0" role="group" aria-label="Навігація дат">
                <Button Class="btn-secondary"
                        IsDisabled="@_loading"
                        OnClickButton="PrevDay">
                    <i class="bi bi-chevron-left"></i>
                </Button>
                <Button Class="btn-primary"
                        Label="Сьогодні"
                        IsDisabled="@_loading"
                        OnClickButton="GoToday" />
                <Button Class="btn-secondary"
                        IsDisabled="@_loading"
                        OnClickButton="NextDay">
                    <i class="bi bi-chevron-right"></i>
                </Button>
            </div>

            <div style="min-width:240px; max-width:320px;" class="flex-grow-1">
                <input class="form-control form-control-sm"
                       value="@_search"
                       @oninput="OnSearchInput"
                       placeholder="Пошук: ПІБ або РНОКПП" />
            </div>

            <Button Class="btn-sm btn-outline-primary flex-shrink-0"
                    Label="Оновити"
                    IsDisabled="@_loading"
                    OnClickButton="ReloadAsync">
                <i class="bi bi-arrow-repeat"></i>
            </Button>
        </div>
    </div>

    <div class="page-content d-flex flex-column overflow-hidden p-2">

        <div class="table-wrap d-flex flex-column p-2">
            <div class="table-scroll flex-grow-1 p-2">
                <Table TItem="TimesheetPersonRangeRowDto"
                       Items="@(_rows ?? [])"
                       Class="table-sm table-bordered table-hover mb-0 align-middle"
                       @bind-SelectedItem="_selected"
                       KeySelector="@(r => r.Person.PersonId)">

                    <TableHeader>
                        <th class="text-center">Тип обліку</th>
                        <th class="text-center">Військовослужбовець</th>
                        <th class="text-center">Дії</th>

                        @for (var i = 0; i < _days.Count; i++)
                        {
                            var d = _days[i];
                            var isAnchor = (i == _anchorIndex);

                            <th class="text-center @(isAnchor ? "bg-primary text-white" : "bg-body-tertiary")">
                                <div class="small">@DowShort(d)</div>
                                <div class="small fw-semibold">@d.ToString("dd.MM")</div>
                            </th>
                        }
                    </TableHeader>

                    <RowTemplate Context="r">
                        <td class="text-center fw-semibold">@GetSign(r.Person.EnrollmentKindDto)</td>

                        <!-- (опційно, але дуже бажано) компактний блок ПІБ -->
                        <td class="min-w-0">
                            <div class="d-flex flex-column lh-sm min-w-0">
                                <div class="d-flex align-items-center gap-2 min-w-0">
                                    @if (!string.IsNullOrWhiteSpace(r.Person.Rank))
                                    {
                                        <span class="text-nowrap">@r.Person.Rank</span>
                                    }
                                    <span class="fw-semibold text-truncate d-block min-w-0">@r.Person.FullName</span>
                                </div>
                                <div class="small font-monospace text-nowrap">@r.Person.Rnokpp</div>
                            </div>
                        </td>

                        <td class="text-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button"
                                        class="btn btn-primary"
                                        title="Створити подію"
                                        disabled="@(!CanOpenTransition(r))"
                                        @onclick="(() => OpenTransition(r))"
                                        @onclick:stopPropagation="true">
                                    <i class="bi bi-plus-lg"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-secondary"
                                        title="Деталі / Персональний табель"
                                        @onclick="(() => OpenPersonDrawer(r))"
                                        @onclick:stopPropagation="true">
                                    <i class="bi bi-person-vcard"></i>
                                </button>
                            </div>
                        </td>

                        @for (var i = 0; i < r.Days.Count; i++)
                        {
                            var day = r.Days[i];
                            var isAnchor = (i == _anchorIndex);

                            <td class="text-center @CellClass(day.Code, isAnchor)" style="width: 65px;"
                                title="@(IsAlert(day.Code) ? day.Reference : null)">

                                <!-- без badge -->
                                <span class="@CodeTextClass(day.Code, isAnchor)">
                                    @ShortCode(day.Code)
                                </span>
                            </td>
                        }
                    </RowTemplate>

                </Table>
            </div>
        </div>
    </div>
</div>

<TimesheetTransitionDrawer IsOpen="@_drawerOpen"
                           IsOpenChanged="@(v => _drawerOpen = v)"
                           PersonId="@_drawerPersonId"
                           InitialDate="@_drawerInitialDate"
                           OperatorDate="@_anchorDate"
                           PersonLabel="@_drawerPersonLabel"
                           OnApplied="ReloadAsync" />

<TimesheetPersonDrawer IsOpen="@_personDrawerOpen"
                       IsOpenChanged="@(v => _personDrawerOpen = v)"
                       Person="@_personDrawerPerson"
                       OnClosed="ClosePersonDrawer" />
