@page "/timesheet"
@using eRaven.Application.DTOs.Timesheets

<PageTitle>Табель</PageTitle>

<div class="page-content">

    <div class="border bg-secondary-subtle">
        <div class="py-2 px-4 text-white">
            Табель (місяць)
        </div>
    </div>

    <div class="container-fluid px-3 py-3">

        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">

            <div class="d-flex flex-column">
                <label class="form-label mb-1">Рік</label>
                <input class="form-control form-control-sm rounded-0"
                       type="number"
                       min="2000"
                       max="2100"
                       step="1"
                       value="@_year"
                       @onchange="OnYearChanged" />
            </div>

            <div class="d-flex flex-column">
                <label class="form-label mb-1">Місяць</label>
                <select class="form-select form-select-sm rounded-0"
                        value="@_month"
                        @onchange="OnMonthChanged">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>

            <div class="flex-grow-1 d-flex flex-column">
                <label class="form-label mb-1">Пошук (ПІБ або РНОКПП)</label>
                <input class="form-control form-control-sm rounded-0"
                       value="@_search"
                       @oninput="OnSearchInput"
                       placeholder="Напр: Іванов або 1234567890" />
            </div>

            <TimesheetExport Year="@_year"
                             Month="@_month" />

            <Button Class="btn-sm btn-outline-secondary rounded-0"
                    IsDisabled="@_loading"
                    OnClickButton="ReloadAsync">
                <span class="d-inline-flex align-items-center gap-1">
                    <span aria-hidden="true">⟳</span>
                    Оновити
                </span>
            </Button>
        </div>

        @if (_loading)
        {
            <p class="px-1"><em>Завантаження...</em></p>
        }
        else
        {
            <div class="small mb-2">
                Рядків: <strong>@(_rows?.Count ?? 0)</strong>
                · Місяць: <strong>@_month</strong> / <strong>@_year</strong>
                · Днів: <strong>@_daysInMonth</strong>
            </div>

            <div class="timesheet-wrap border">
                <Table TItem="TimesheetPersonRangeRowDto"
                       Items="@(_rows ?? [])"
                       Class="table-sm table-bordered mb-0 timesheet-table"
                       @bind-SelectedItem="_selected"
                       KeySelector="@(r => r.Person.PersonId)">

                    <TableHeader>
                        <th class="px-2 text-center" style="width:100px">Тип обліку</th>
                        <th style="width:200px">ПІБ</th>
                        <th class="text-center" title="Деталі">
                            <span aria-hidden="true">🔍</span>
                        </th>
                        @for (var d = 1; d <= _daysInMonth; d++)
                        {
                            <th class="text-center">@d</th>
                        }
                    </TableHeader>

                    <RowTemplate Context="r">
                        <td class="text-center fw-semibold">
                            <span>@GetSign(r.Person.EnrollmentKindDto)</span>
                        </td>
                        <td>
                            <span class="mx-2">@ToInitials(r.Person.FullName)</span>
                        </td>
                        <td class="text-center">
                            <Button Class="btn-sm btn-secondary rounded-2"
                                    Label="..."
                                    StopPropagation="true"
                                    OnClickButton="@(() => OpenPersonDrawer(r))" />
                        </td>

                        @for (var day = 1; day <= _daysInMonth; day++)
                        {
                            var snap = GetDay(r.Days, day);
                            var main = snap?.Code;
                            var tdClass = GetCellClass(main);

                            <td class="text-center ts-cell @tdClass">
                                @if (!string.IsNullOrWhiteSpace(main))
                                {
                                    <div class="ts-main"
                                         title="@(IsAlert(main) ? snap?.Reference : null)">
                                        @ShortCode(main!)
                                    </div>
                                }
                            </td>
                        }
                    </RowTemplate>

                </Table>
            </div>
        }
    </div>
</div>

<TimesheetPersonDrawer IsOpen="@_personDrawerOpen"
                       IsOpenChanged="@(v => _personDrawerOpen = v)"
                       Person="@_personDrawerPerson"
                       OnClosed="ClosePersonDrawer" />