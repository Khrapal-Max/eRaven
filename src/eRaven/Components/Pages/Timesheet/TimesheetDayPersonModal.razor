@using eRaven.Application.DTOs.Timesheet
@using eRaven.Components.Shared.Modal

<Modal IsOpen="@IsOpen"
       IsOpenChanged="@(_ => OnClose.InvokeAsync())"
       Title="Табель — запис">

    @if (Row is null)
    {
        <div class="small">Немає даних.</div>
    }
    else
    {
        <div class="mb-2">
            <div class="fw-semibold">@Row.FullName</div>
            <div class="small">РНОКПП: @Row.RNOKPP · Дата: @Date</div>
        </div>

        <div class="border rounded-2 p-2">
            <div class="d-flex justify-content-between">
                <span>Main</span>
                <span class="fw-semibold">@Row.MainCode</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Task</span>
                <span class="fw-semibold">@Row.TaskCode</span>
            </div>
        </div>

        <div class="small mt-2">
            Редагування (створення/нарізка інтервалів) додамо наступним кроком.
        </div>
    }

</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public DateOnly Date { get; set; }
    [Parameter] public TimesheetDayPerPersonCurrentStateDto? Row { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
