@using eRaven.Application.DTOs.Timesheet
@using eRaven.Domain.Enums

@if (IsOpen && Person is not null)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content rounded-0">

                <div class="modal-header">
                    <h5 class="modal-title">Картка в табелі</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>

                <div class="modal-body">

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <div class="border p-2">
                                <div class="fw-semibold">@Person.FullName</div>
                                <div>@Person.RNOKPP</div>
                                <div class="small font-monospace">Id: @Person.PersonId</div>
                            </div>
                        </div>
                   
                        <div class="col-12 col-md-6">
                            <div class="border p-2">
                                <div class="small">Звання</div>
                                <div>@(Person.Rank ?? "-")</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="border p-2">
                                <div class="small">Посада</div>
                                <div>@(Person.Position ?? "-")</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="border p-2">
                                <div class="small">Зараховано</div>
                                <div>@(Person.EnrolledAt?.ToString("dd-MM-yyyy") ?? "-")</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="border p-2">
                                <div class="small">Виключено</div>
                                <div>@(Person.ExcludedAt?.ToString("dd-MM-yyyy") ?? "-")</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="border p-2">
                                <div class="small">Оновлено табель</div>
                                <div>@(Person.Timesheet?.UpdatedAtUtc == null ? "-" : Person.Timesheet!.UpdatedAtUtc.ToString("u"))</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-sm btn-outline-secondary rounded-0" @onclick="Close">Закрити</button>
                </div>

            </div>
        </div>
    </div>
}
