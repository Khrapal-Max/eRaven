@page "/timesheet/policy"
@using eRaven.Domain.Enums

<div class="page-flex">

    <!-- Toolbar -->
    <div class="d-flex align-items-center gap-2 px-3 py-2 border rounded-2 bg-body text-white">
        <div class="fw-semibold">Політика переходів</div>

        @if (_selected is not null)
        {
            <div class="ms-2 small">
                Lane: <span class="fw-semibold text-body">@_selectedLane</span>,
                Код: <span class="font-monospace fw-semibold text-body">@_selected.Code</span>
            </div>
        }

        <Button Class="btn-sm btn-primary ms-auto"
                Label="Зберегти"
                IsDisabled="!_canSave || _selected is null"
                OnClickButton="SaveAsync" />
    </div>

    <div class="page-content">
        <div class="border rounded-2 overflow-hidden h-100">
            <div class="row g-0 h-100">

                <!-- Left: grouped list -->
                <div class="col-4 border-end h-100 overflow-auto">

                    <div class="list-group list-group-flush">
                        @foreach (var s in _mainCodes)
                        {
                            var selected = _selected?.Id == s.Id;

                            <button type="button"
                                    class="list-group-item list-group-item-action text-body @(selected ? "list-group-item-primary" : "list-group-item-secondary")"
                                    @onclick="() => SelectAsync(TimesheetLane.Main, s)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-truncate me-2">Main lane: @s.Title</span>
                                    <span class="font-monospace">@s.Code</span>
                                </div>
                            </button>
                        }
                    </div>

                    <div class="list-group list-group-flush border-top border-warning">
                        @foreach (var s in _taskCodes)
                        {
                            var selected = _selected?.Id == s.Id;

                            <button type="button"
                                    class="list-group-item list-group-item-action text-body @(selected ? "list-group-item-primary" : "list-group-item-secondary")"
                                    @onclick="() => SelectAsync(TimesheetLane.Task, s)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-truncate me-2">Task lane: @s.Title</span>
                                    <span class="font-monospace">@s.Code</span>
                                </div>
                            </button>
                        }
                    </div>

                </div>

                <!-- Right: transitions (same-lane only) -->
                <div class="col-8 h-100 overflow-auto">
                    @if (_selected is null)
                    {
                        <div class="p-3">Оберіть статус зліва (Main або Task).</div>
                    }
                    else
                    {
                        <div class="p-3">
                            <div class="mb-2">
                                <div class="fw-semibold">
                                    <span class="badge text-bg-secondary me-2">@_selectedLane</span>
                                    З: <span class="font-monospace">@_selected.Code</span> — @_selected.Title
                                </div>
                                <div class="text-muted small">
                                    Дозволені переходи показані тільки в межах цього lane.
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <Button Class="btn-sm btn-outline-secondary"
                                        Label="Вибрати всі"
                                        OnClickButton="SelectAll" />

                                <Button Class="btn-sm btn-outline-secondary"
                                        Label="Очистити"
                                        OnClickButton="ClearAll" />
                            </div>

                            <div class="row g-2">
                                <div class="col-12">
                                <div class="row g-2 mb-3">
                                    <div class="col-12 col-lg-6">
                                        <label class="form-label small text-muted mb-1">Семантика дати “по/закінчення”</label>
                                        <select class="form-select form-select-sm"
                                                value="@_endDateMeaning"
                                                @onchange="OnMeaningChanged">
                                            <option value="@TimesheetEndDateMeaning.LastDayOfThisCode">Останній день цього коду (inclusive)</option>
                                            <option value="@TimesheetEndDateMeaning.FirstDayOfNextCode">Перший день наступного коду (return/effective)</option>
                                        </select>
                                    </div>

                                    @if (_selectedLane == TimesheetLane.Main && _endDateMeaning == TimesheetEndDateMeaning.FirstDayOfNextCode)
                                    {
                                        <div class="col-12 col-lg-6">
                                            <label class="form-label small text-muted mb-1">Наступний код на дату (зазвичай 30)</label>
                                            <select class="form-select form-select-sm"
                                                    value="@(_nextCodeOnEnd ?? "30")"
                                                    @onchange="OnNextCodeChanged">
                                                @foreach (var c in _mainCodes)
                                                {
                                                    <option value="@c.Code">@c.Code — @c.Title</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                                </div>
                                @foreach (var t in RightPanelTargets())
                                {
                                    var checkedVal = _allowedTo.Contains(t.Id);

                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-check m-0">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   checked="@checkedVal"
                                                   @onchange="(e) => Toggle(t.Id, e.Value is bool b && b)" />
                                            <span class="form-check-label">
                                                <span class="font-monospace">@t.Code</span> — @t.Title
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>

</div>