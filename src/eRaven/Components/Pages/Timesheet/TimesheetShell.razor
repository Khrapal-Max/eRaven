@page "/timesheet"
@using eRaven.Domain.Enums
@using eRaven.Application.Catalogs.Timesheet

<PageTitle>Табель</PageTitle>

<div class="page-content text-black">
    <div class="border bg-secondary-subtle">
        <div class="py-2 px-4 text-dark">
            Табель (MVP). Вибір статусів та коди.
        </div>
    </div>

    <div class="container-fluid px-3 py-3">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <div class="btn-group">
                <button class="btn btn-outline-secondary btn-sm rounded-0 @( _lane == TimesheetLane.Main ? "active" : "" )"
                        @onclick="() => SetLane(TimesheetLane.Main)">
                    Main
                </button>
                <button class="btn btn-outline-secondary btn-sm rounded-0 @( _lane == TimesheetLane.Task ? "active" : "" )"
                        @onclick="() => SetLane(TimesheetLane.Task)">
                    Task
                </button>
            </div>

            <div class="ms-auto small text-muted">
                Легенда: натисни код — згодом відкриватимемо Drawer “Створити запис”.
            </div>
        </div>

        <div class="card rounded-0">
            <div class="card-header bg-transparent">
                <strong>Легенда кодів (@_lane)</strong>
            </div>

            <div class="card-body">
                @if (_options.Count == 0)
                {
                    <em>Немає статусів для цієї lane.</em>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var s in _options)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary rounded-0"
                                    title="@s.Title"
                                    @onclick="() => OnPickStatus(s)">
                                <span class="fw-semibold">@s.Code</span>
                                <span class="ms-2">@s.Title</span>
                                @if (s.IsCodeTemplate)
                                {
                                    <span class="ms-2 badge text-bg-secondary">template</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="mt-3 alert alert-info rounded-0">
            Наступний крок: підключаємо CRUD (TimesheetRepository) + Drawer створення/редагування запису
            і формуємо “місячний табель” запитом.
        </div>
    </div>
</div>
