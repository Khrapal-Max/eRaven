@using eRaven.Domain.Enums

<Drawer Title="Перехід стану (закрити → почати)"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        DisableClose="@_busy"
        OnClosed="OnDrawerClosed">

    <ChildContent>
        @if (IsOpen)
        {
            <div class="drawer-grow">

                @if (Person is not null)
                {
                    <!-- Person snapshot -->
                    <div class="border p-2 bg-white mb-3">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate">@Person.FullName</div>
                                <div class="small text-nowrap">
                                    РНОКПП: <span class="font-monospace">@Person.RNOKPP</span>
                                </div>
                            </div>

                            <div class="small text-end text-nowrap">
                                <div class="font-monospace">@Person.PersonId</div>
                                <div>Anchor: <span class="fw-semibold">@Date.ToString("dd.MM.yyyy")</span></div>
                            </div>
                        </div>
                    </div>
                }

                @if (_loading)
                {
                    <div class="px-2"><em>Завантаження...</em></div>
                }
                else if (Person is null)
                {
                    <div class="alert alert-warning rounded-0 mb-0">Немає даних по особі.</div>
                }
                else
                {
                    <!-- Current state (minimal) -->
                    <div class="border p-2 mb-3 bg-white">
                        <div class="fw-semibold mb-1">Поточний стан</div>

                        @if (_timeline is null)
                        {
                            <div class="alert alert-warning rounded-0 mb-0">
                                Немає активної шкали на цю дату (особа поза табелем).
                            </div>
                        }
                        else
                        {
                            <div class="small">
                                В табелі з:
                                <span class="font-monospace">@_timeline.OpenedAt.ToString("dd.MM.yyyy")</span>

                                @if (_timeline.ClosedAt is not null)
                                {
                                    <span>
                                        · Виключений з табелю:
                                        <span class="font-monospace">@_timeline.ClosedAt.Value.ToString("dd.MM.yyyy")</span>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    @if (_timeline is not null && _active is null)
                    {
                        <div class="alert alert-warning rounded-0 mb-3">
                            Немає активного запису на цю дату (немає історії).
                        </div>
                    }

                    <!-- Form -->
                    <EditForm EditContext="@_editContext" OnValidSubmit="SubmitAsync" id="ts-event-form">
                        <DataAnnotationsValidator />

                        <div class="border p-2 mb-3">
                            <div class="row g-2">

                                <!-- Next state -->
                                <div class="col-12 col-md-6">
                                    <div class="border p-2">
                                        <div class="small">Початок події з:</div>
                                        <div class="font-monospace fw-semibold">
                                            @_computedNextFrom.ToString("dd.MM.yyyy")
                                        </div>

                                        <div class="fw-semibold">Наступний статус</div>

                                        <div class="mt-2">
                                            <label class="form-label mb-1">Дозволені коди</label>

                                            <InputSelect class="form-select rounded-0 bg-warning text-black"
                                                         @bind-Value="Model.NextCode"
                                                         @bind-Value:after="OnNextCodeChanged">
                                                <option value="">— оберіть код —</option>
                                                @foreach (var c in _allowedCodes)
                                                {
                                                    <option value="@c.Code">@c.Code · @c.Title</option>
                                                }
                                            </InputSelect>

                                            <ValidationMessage For="@(() => Model.NextCode)" />

                                            @if (_nextDef is not null)
                                            {
                                                <div class="small mt-1">@_nextDef.Title</div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Active state -->
                                <div class="col-12 col-md-6">
                                    <div class="border p-2">
                                        <div class="fw-semibold">Активний статус</div>

                                        @if (_active is null)
                                        {
                                            <div class="small mt-1">—</div>
                                        }
                                        else
                                        {
                                            <div>
                                                <span class="fw-semibold">@(_activeDef?.Title ?? "Без назви")</span>
                                                <span class="small">
                                                    (код <span class="font-monospace fw-semibold">@Normalize(_active.Code)</span>)
                                                </span>
                                            </div>

                                            <div class="small">
                                                з <span class="font-monospace">@_active.From.ToString("dd.MM.yyyy")</span>
                                                @if (_active.To is not null)
                                                {
                                                    <span> по <span class="font-monospace">@_active.To.Value.ToString("dd.MM.yyyy")</span></span>
                                                }
                                            </div>
                                        }

                                        <div class="mt-2">
                                            <label class="form-label mb-1">Дата “по/закінчення”</label>

                                            <InputDate class="form-control rounded-0 bg-dark text-white"
                                                       @bind-Value="Model.InputDate"
                                                       @bind-Value:after="OnInputDateChanged" />

                                            <ValidationMessage For="@(() => Model.InputDate)" />

                                            @if (_active is not null)
                                            {
                                                <div class="form-text text-black">
                                                    Не раніше:
                                                    <span class="font-monospace">@_active.From.ToString("dd.MM.yyyy")</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Reference / Note -->
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label mb-1">Референс</label>
                                <InputText class="form-control rounded-0" @bind-Value="Model.Reference" />
                                <ValidationMessage For="@(() => Model.Reference)" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label mb-1">Примітка</label>
                                <InputText class="form-control rounded-0" @bind-Value="Model.Note" />
                                <ValidationMessage For="@(() => Model.Note)" />
                            </div>
                        </div>
                    </EditForm>
                }
            </div>
        }
    </ChildContent>

    <FooterContent>
        <Button Class="btn-outline-secondary rounded-0"
                Label="Скасувати"
                IsDisabled="@_busy"
                OnClickButton="OnCancel" />

        <button type="submit"
                form="ts-event-form"
                class="btn btn-primary rounded-0"
                disabled="@DisabledSave">
            Застосувати
        </button>
    </FooterContent>

</Drawer>
