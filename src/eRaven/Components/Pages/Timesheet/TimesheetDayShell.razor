@page "/timesheet/day"
@using eRaven.Application.DTOs.Timesheet
@using eRaven.Domain.Enums

<PageTitle>Табель (день)</PageTitle>

<div class="page-content">

    <div class="border bg-secondary-subtle">
        <div class="py-2 px-4 text-white">
            Табель (день)
        </div>
    </div>

    <div class="container-fluid px-3 py-3">

        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">

            <div class="d-flex flex-column">
                <label class="form-label mb-1">Дата</label>
                <input class="form-control form-control-sm rounded-0 bg-dark text-white"
                       type="date"
                       value="@_date.ToString("yyyy-MM-dd")"
                       @onchange="OnDateChanged" />
            </div>

            <div class="d-flex flex-column">
                <label class="form-label mb-1">Тип</label>
                <select class="form-select form-select-sm rounded-0"
                        value="@_kind"
                        @onchange="OnKindChanged">
                    <option value="">Всі</option>
                    <option value="Unit">ШТ</option>
                    <option value="AttachedByList">НК</option>
                    <option value="AttachedByOrder">БР</option>
                </select>
            </div>

            <div class="flex-grow-1 d-flex flex-column">
                <label class="form-label mb-1">Пошук (ПІБ або РНОКПП)</label>
                <input class="form-control form-control-sm rounded-0"
                       value="@_search"
                       @oninput="OnSearchInput"
                       placeholder="Напр: Іванов або 1234567890" />
            </div>

            <div class="form-check mb-1">
                <input class="form-check-input"
                       type="checkbox"
                       checked="@_activeOnly"
                       @onchange="OnActiveOnlyChanged" />
                <label class="form-check-label">Active only</label>
            </div>

            <Button Class="btn-sm btn-outline-secondary rounded-0"
                    IsDisabled="@_loading"
                    OnClickButton="ReloadAsync">
                <span class="d-inline-flex align-items-center gap-1">
                    <span aria-hidden="true">⟳</span>
                    Оновити
                </span>
            </Button>
        </div>

        @if (_loading)
        {
            <p class="px-1"><em>Завантаження...</em></p>
        }
        else if (_error is not null)
        {
            <div class="alert alert-danger rounded-0">@_error</div>
        }
        else
        {
            <div class="small mb-2">
                Дата: <strong>@_date.ToString("dd.MM.yyyy")</strong>
                · Рядків: <strong>@(_rows?.Count ?? 0)</strong>
            </div>

            <div class="timesheet-wrap border">
                <Table TItem="TimesheetDayPerPersonCurrentStateDto"
                       Items="@(_rows ?? [])"
                       Class="table-bordered mb-0"
                       @bind-SelectedItem="_selected"
                       KeySelector="@(r => r.PersonId)">

                    <TableHeader>
                        <th class="px-2 text-center"x">Тип</th>
                        <th>Звання</th>
                        <th>ПІБ</th>
                        <th class="text-center">Main</th>
                        <th class="text-center">Task</th>
                        <th class="text-center">Дія</th>
                    </TableHeader>

                    <RowTemplate Context="r">
                        <td class="text-center fs-semibold">
                            @GetSign(r.EnrollmentKind)
                        </td>
                        <td>
                            <span class="fs-semibold">@r.Rank</span>
                        </td>
                        <td>
                            <span class="text-nowrap">@r.FullName</span>
                        </td>

                        <td class="text-center @GetCellClassForCode(r.MainCode, TimesheetLane.Main)">
                            <div class="ts-main" title="@r.MainCode">@ShortCode(r.MainCode)</div>
                        </td>

                        <td class="text-center @GetCellClassForCode(r.TaskCode, TimesheetLane.Task)">
                            @if (!string.IsNullOrWhiteSpace(r.TaskCode))
                            {
                                <div class="ts-task" title="@r.TaskCode">@ShortCode(r.TaskCode)</div>
                            }
                        </td>

                        <td class="text-center">
                            <Button Class="btn-sm btn-secondary rounded-2"
                                    Label="Змінити…"
                                    StopPropagation="true"
                                    OnClickButton="@(() => OpenModal(r))" />
                        </td>
                    </RowTemplate>

                </Table>
            </div>
        }
    </div>
</div>

<TimesheetDayPersonModal IsOpen="@_modalOpen"
                         Date="@_date"
                         Row="@_modalRow"
                         OnClose="CloseModal" />
