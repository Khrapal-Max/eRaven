<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <strong>Табель</strong>
        <div class="small">OccurredAtUtc (хто/коли вніс). Тут видно корекції та відміни подій.</div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary rounded-0" type="button">Скопіювати ID</button>
        <button class="btn btn-sm btn-outline-secondary rounded-0" type="button">Експорт</button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th style="width:170px;">OccurredAt</th>
                <th style="width:190px;">Type</th>
                <th>Details</th>
                <th style="width:120px;">Author</th>
                <th style="width:80px;" class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
            @* приклад: заміниш на foreach по реальних евентах *@

            <tr>
                <td>2026-01-08 12:22</td>
                <td>PersonPositionChanged</td>
                <td>Position = “Оператор”</td>
                <td>admin</td>
                <td class="text-end">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger rounded-0"
                            data-bs-toggle="modal"
                            data-bs-target="#voidEvent"
                            @onclick="() => OpenVoid(Guid.NewGuid())">
                        Відміна події
                    </button>
                </td>
            </tr>

            <tr>
                <td>2026-01-08 12:10</td>
                <td>PersonRankChanged</td>
                <td>Rank = “Солдат”</td>
                <td>admin</td>
                <td class="text-end">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger rounded-0"
                            data-bs-toggle="modal"
                            data-bs-target="#voidEvent"
                            @onclick="() => OpenVoid(Guid.NewGuid())">
                        Відміна події
                    </button>
                </td>
            </tr>

            <tr>
                <td>2026-01-07 09:00</td>
                <td>PersonCandidateCreated</td>
                <td>PersonalInfo, PlannedPosition</td>
                <td>admin</td>
                <td class="text-end">
                    <button type="button"
                            class="btn btn-sm btn-outline-danger rounded-0"
                            data-bs-toggle="modal"
                            data-bs-target="#voidEvent"
                            @onclick="() => OpenVoid(Guid.NewGuid())">
                        Відміна події
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<VoidEventDrawer PersonId="PersonId" TargetEventId="_voidTargetEventId" />

@code {
    [Parameter] public Guid PersonId { get; set; }

    private Guid? _voidTargetEventId;

    private void OpenVoid(Guid eventId)
       => _voidTargetEventId = eventId;
}