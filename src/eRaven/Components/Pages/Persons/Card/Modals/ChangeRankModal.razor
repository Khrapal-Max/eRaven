<div class="modal fade" id="changeRank" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-0">
            <div class="modal-header">
                <h5 class="modal-title">Зміна звання</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label">EffectiveDate</label>
                    <input class="form-control rounded-0" placeholder="yyyy-mm-dd (stub)" />
                </div>

                <div class="mb-2">
                    <label class="form-label">Звання</label>
                    <input class="form-control rounded-0" placeholder="Напр. Солдат" />
                </div>

                <div class="mb-2">
                    <label class="form-label">Примітка (optional)</label>
                    <input class="form-control rounded-0" placeholder="№ наказу / коментар" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Скасувати</button>
                <button class="btn btn-primary rounded-0" data-bs-dismiss="modal">Зберегти (stub)</button>
            </div>
        </div>
    </div>
</div>
@code {
    [Parameter] public Guid PersonId { get; set; }
}