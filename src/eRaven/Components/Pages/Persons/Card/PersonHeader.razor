@inject NavigationManager Nav

<div class="d-flex align-items-start justify-content-between">
    <div>
        <button class="btn btn-sm btn-outline-secondary rounded-0 mb-2"
                @onclick="Back">
            ← Назад
        </button>


        <h5 class="m-0">Ivanov Ivan Ivanovich</h5>
        <div class="text-muted small">
            RNOKPP: 1234567890 • Kind: <span class="badge text-bg-light border text-muted">Unit</span> • Ref: -
        </div>

        <div class="mt-2 d-flex flex-wrap gap-2">
            <span class="badge text-bg-success">Enrolled</span>
            <span class="badge text-bg-secondary">Active</span>
            <span class="badge text-bg-light border text-muted">Rank: Солдат</span>
            <span class="badge text-bg-light border text-muted">Pos: Оператор</span>
        </div>
    </div>

    <div class="text-end">
        <div class="text-muted small">ID:</div>
        <div class="font-monospace small">@PersonId</div>
    </div>
</div>

<hr class="mt-3" />

@code {
    [Parameter] public Guid PersonId { get; set; }

    private void Back() => Nav.NavigateTo("/persons");
}
