@using eRaven.Application.DTOs

<div class="px-2 card rounded-0 border">
    <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
        <strong>Поточний стан</strong>
        <span class="small">Оновлено: @Person.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
    </div>

    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="small">Стадія</div>
                <div class="fw-semibold">@LifecycleText(Person.Lifecycle)</div>
            </div>

            <div class="col-12 col-md-6">
                <div class="small">В списках</div>
                <div class="fw-semibold">@((Person.EnrolledAt?.ToString("dd-MM-yyyy")) ?? "—")</div>
            </div>            

            <div class="col-12 col-md-6">
                <div class="small">Звання</div>
                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Person.Rank) ? Person.Rank : "—")</div>
            </div>            

            <div class="col-12 col-md-6">
                <div class="small">Посада</div>
                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Person.Position) ? Person.Position : "—")</div>
            </div>

            <div class="col-12 col-md-6">
                <div class="small">ТВО (посада)</div>
                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Person.TemporaryPosition) ? Person.TemporaryPosition : "—")</div>
            </div>

            <div class="col-12 col-md-6">
                <div class="small">БЗВП</div>
                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Person.Bzvp) ? Person.Bzvp : "—")</div>
            </div>

            <div class="col-12 col-md-6">
                <div class="small">Зброя</div>
                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Person.Weapon) ? Person.Weapon : "—")</div>
            </div>

            <div class="col-12 col-md-6">
                <div class="small">Позивний</div>
                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Person.Callsign) ? Person.Callsign : "—")</div>
            </div>
        </div>

        <hr />
        <div class="small">
            * Цей блок показує “як зараз”. Для “як було на дату” дивись вкладку Кар’єра.
        </div>
    </div>
</div>