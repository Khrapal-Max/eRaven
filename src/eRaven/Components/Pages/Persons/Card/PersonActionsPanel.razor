@using eRaven.Application.DTOs
@using eRaven.Domain.Enums

<div class="card d-grid gap-2">
    @if (Person.Lifecycle is PersonLifecycle.Candidate or PersonLifecycle.Excluded)
    {
        <Button Class="btn-outline-success rounded-0"
                Label="Зарахувати в списки" />
    }

    @if (Person.Lifecycle == PersonLifecycle.Enrolled)
    {
        <Button Class="btn-outline-danger rounded-0"
                Label="Виключити зі списків" />
    }

    <hr class="my-2" />

    @* Secondary *@
    <button class="btn btn-outline-primary rounded-0" data-bs-toggle="modal" data-bs-target="#changeRank">
        Змінити звання
    </button>

    <button class="btn btn-outline-primary rounded-0" data-bs-toggle="modal" data-bs-target="#changePosition">
        Змінити посаду
    </button>

    <hr class="my-2" />

    <Button Class="btn-outline-secondary rounded-0"
            Label="Змінити ТВО посаду" />
    <Button Class="btn-outline-secondary rounded-0"
            Label="Змінити БЗВП" />
    <Button Class="btn-outline-secondary rounded-0"
            Label="Змінити зброю" />
    <Button Class="btn-outline-secondary rounded-0"
            Label="Змінити позивний" />
</div>