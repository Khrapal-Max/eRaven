@using Microsoft.AspNetCore.Components.Forms
@using eRaven.Application.DTOs
@using eRaven.Components.Shared.Validation
@using eRaven.Components.Shared.Drawer

<Drawer Title="Зміна звання"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        DisableClose="@_busy"
        OnClosed="OnDrawerClosed">

    <ChildContent>
        @if (IsOpen)
        {
            <EditForm EditContext="@_editContext"
                      OnValidSubmit="OnChangeAsync"
                      id="change-rank-form">

                <FluentValidationValidator />

                <div class="drawer-grow">

                    <h6 class="mb-3">Професійні / військові дані</h6>

                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Звання</label>

                            <div class="dropdown w-100">
                                <button class="btn btn-outline-secondary dropdown-toggle w-100 text-truncate"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    @(string.IsNullOrWhiteSpace(Model.Rank) ? "— оберіть звання —" : Model.Rank)
                                </button>

                                <ul class="dropdown-menu border w-100 overflow-auto" style="max-height: 30vh;">
                                    @foreach (var title in _ranks)
                                    {
                                        <li>
                                            <Button Class="dropdown-item"
                                                    Label="@title.Title"
                                                    OnClickButton="() => Model.Rank = title.Title" />
                                        </li>
                                    }
                                </ul>
                            </div>

                            <ValidationMessage For="@(() => Model.Rank)" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">Дата зміни</label>
                            <InputDate class="form-control rounded-0 bg-light-subtle text-white" @bind-Value="Model.EffectiveDate" />
                            <ValidationMessage For="@(() => Model.EffectiveDate)" />
                        </div>

                        <div class="row g-2">     

                            <div class="col-12">
                                <label class="form-label mb-1">Замітка (опц.)</label>
                                <InputText class="form-control rounded-0" @bind-Value="Model.Note" />
                                    <ValidationMessage For="@(() => Model.Note)" />
                            </div>
                        </div>
                      
                    </div>
                </div>
            </EditForm>
        }
    </ChildContent>

    <FooterContent>
        <Button Class="btn-outline-secondary rounded-0"
                Label="Скасувати"
                IsDisabled="@_busy"
                OnClickButton="OnCancel" />

        <!-- ✅ тільки submit, без @onclick -->
        <button type="submit"
                form="change-rank-form"
                class="btn btn-primary rounded-0"
                disabled="@_busy">
            Змінити
        </button>
    </FooterContent>
</Drawer>
