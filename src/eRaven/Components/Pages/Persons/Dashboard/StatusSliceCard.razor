@inject NavigationManager Nav

<div class="card rounded-0 h-100" role="button" @onclick="Go">
    <div class="card-body">
        <div class="d-flex align-items-start justify-content-between">
            <div>
                <div class="text-muted small">@Title</div>
                <div class="fs-2 fw-semibold">@Count</div>
                <div class="text-muted small">@Hint</div>
            </div>
            <span class="badge @BadgeClass">●</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int Count { get; set; }
    [Parameter] public string Hint { get; set; } = "";
    [Parameter] public string NavigateTo { get; set; } = "/persons";
    [Parameter] public string BadgeClass { get; set; } = "text-bg-secondary";

    private void Go() => Nav.NavigateTo(NavigateTo);
}
