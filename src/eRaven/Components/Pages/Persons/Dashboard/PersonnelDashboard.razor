@page "/dashboard/personnel"
@inject NavigationManager Nav

<div class="page-content text-black">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h5 class="m-0">Штатний облік</h5>
            <small>Оперативні зрізи, контроль заповнення, останні зміни</small>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-0">Дата ⏷</button>
            <button class="btn btn-outline-secondary btn-sm rounded-0" @onclick="GoToRegistry">В реєстр</button>
        </div>
    </div>

    <ChangesChipsBar />

    <div class="row g-3 mt-1">
        <div class="col-12 col-md-6 col-xl-3">
            <StatusSliceCard Title="Active" Count="124" Hint="Активні на дату" NavigateTo="/persons" BadgeClass="text-bg-success" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <StatusSliceCard Title="Candidates" Count="18" Hint="Кандидати" NavigateTo="/persons" BadgeClass="text-bg-secondary" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <StatusSliceCard Title="Attached (Order)" Count="7" Hint="Приряджені по наказу" NavigateTo="/persons" BadgeClass="text-bg-warning" />
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <StatusSliceCard Title="Excluded" Count="3" Hint="Виключені" NavigateTo="/persons" BadgeClass="text-bg-danger" />
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-12 col-xl-7">
            <div class="card rounded-0">
                <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                    <strong>Останні зміни</strong>
                    <button class="btn btn-sm btn-outline-secondary rounded-0">Деталі</button>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>08.01 — Rank changed: Ivanov I.I.</li>
                        <li>08.01 — Enrolled: Petrenko P.P. (AttachedByOrder)</li>
                        <li>07.01 — Callsign cleared: Sidorov S.S.</li>
                        <li>07.01 — Voided event: wrong position</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card rounded-0">
                <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
                    <strong>Контроль заповнення</strong>
                    <button class="btn btn-sm btn-outline-secondary rounded-0">Перевірка</button>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Без звання</span>
                        <span class="badge text-bg-warning">4</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Без посади</span>
                        <span class="badge text-bg-warning">2</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Без БЗВП</span>
                        <span class="badge text-bg-secondary">11</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Кандидати без планової посади</span>
                        <span class="badge text-bg-secondary">6</span>
                    </div>

                    <hr />
                    <button class="btn btn-outline-primary rounded-0 w-100">Перейти у реєстр з фільтром</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoToRegistry() => Nav.NavigateTo("/persons");
}