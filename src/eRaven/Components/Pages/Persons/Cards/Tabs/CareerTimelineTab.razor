@using eRaven.Application.DTOs
@using eRaven.Application.DTOs.Person
@using eRaven.Components.Shared.Table

<div class="d-flex align-items-center">
    <div class="fw-semibold">Кар'єра (історія подій)</div>
</div>

@if (_loading)
{
    <p class="mb-0"><em>Завантаження...</em></p>
}
else if (_events.Count == 0)
{
    <div class="alert alert-secondary rounded-0 mb-0">
        Подій немає.
    </div>
}
else
{
    <Table TItem="PersonEventListItemDto"
           Items="_events"
           SelectedItem="_selected"
           SelectedItemChanged="@(v => _selected = v)"
           KeySelector="@(e => e.EventId)"
           OnClick="OnRowClick">

        <TableHeader>
            <th>#</th>
            <th>Діє з</th>
            <th>Подія</th>
            <th>Автор</th>
            <th>Записано (UTC)</th>
            <th>Дія</th>
        </TableHeader>

        <RowTemplate Context="e">
            <td class="font-monospace">@e.Version</td>

            <td class="font-monospace">
                @(e.EffectiveDate?.ToString("dd-MMMM-yyyy") ?? "Системна подія")
            </td>

            <td class="text-truncate" title="@($"{e.Title} {e.Details}")">
                @if (e.IsVoided)
                {
                    <span class="badge bg-danger">Скасовано</span>
                }
                <div class="fw-semibold text-truncate">
                    @e.Title
                </div>

                @if (!string.IsNullOrWhiteSpace(e.Details))
                {
                    <div class="small text-wrap" style="max-width:650px">
                        @e.Details
                    </div>
                }
            </td>

            <td class="text-truncate" title="@e.Author">
                @e.Author
            </td>

            <td class="font-monospace">
                @e.OccurredAtUtc.ToString("dd-MM-yyyy HH:mm")
            </td>

            <td>
                @if (!e.IsVoided && e.EventId != Guid.Empty)
                {
                    <Button Class="btn-outline-danger btn-sm rounded-0"
                            Label="Відміна події"
                            StopPropagation="true"
                            OnClickButton="@(() => OpenVoid(e))" />
                }
            </td>
        </RowTemplate>
    </Table>
}

<VoidPersonalEventDrawer PersonId="PersonId"
                         TargetEventId="_voidTargetEventId"
                         TargetTitle="_voidTarget?.Title"
                         TargetDetails="_voidTarget?.Details"
                         IsOpen="_voidOpen"
                         IsOpenChanged="@(v => _voidOpen = v)"
                         OnVoidEvent="HandleVoidAsync" />
