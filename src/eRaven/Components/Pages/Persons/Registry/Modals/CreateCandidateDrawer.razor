@using Microsoft.AspNetCore.Components.Forms
@using eRaven.Application.DTOs

<div class="drawer-backdrop @(IsOpen ? "show" : "")"
     @onclick="OnBackdropClick"
     aria-hidden="@AriaHidden">
</div>

<aside class="drawer-panel @(IsOpen ? "show" : "")"
       role="dialog"
       aria-modal="@AriaModal"
       aria-hidden="@AriaHidden">
    <div class="drawer-header">
        <div class="drawer-title">Створити кандидата</div>

        <Button Class="btn-sm btn-outline-secondary rounded-0"
                Label="✕"
                IsDisabled="@_busy"
                OnClickButton="Close" />
    </div>

    <div class="drawer-body">
        @if (IsOpen)
        {
            <EditForm EditContext="@_editContext" class="drawer-form">
                <DataAnnotationsValidator />

                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label mb-1">РНОКПП (10 цифр)</label>
                        <InputText class="form-control rounded-0" @bind-Value="Model.Rnokpp" />
                        <ValidationMessage For="@(() => Model.Rnokpp)" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label mb-1">Прізвище</label>
                        <InputText class="form-control rounded-0" @bind-Value="Model.LastName" />
                        <ValidationMessage For="@(() => Model.LastName)" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label mb-1">Ім’я</label>
                        <InputText class="form-control rounded-0" @bind-Value="Model.FirstName" />
                        <ValidationMessage For="@(() => Model.FirstName)" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label mb-1">По батькові (опц.)</label>
                        <InputText class="form-control rounded-0" @bind-Value="Model.MiddleName" />
                    </div>
                </div>
                <div class="mt-2 drawer-grow">
                    <PositionUnitPicker Items="_positions"
                                        SelectedId="@Model.PlannedPositionUnitId"
                                        SelectedIdChanged="v => Model.PlannedPositionUnitId = v"
                                        OnSelected="OnPositionSelected"
                                        Label="Вакантна посада (опц.)" />
                </div>
            </EditForm>
        }
    </div>

    <div class="drawer-footer">
        <Button Class="btn-outline-secondary rounded-0"
                Label="Скасувати"
                IsDisabled="@_busy"
                OnClickButton="OnCancel" />

        <Button Class="btn-primary rounded-0"
                Label="Створити"
                IsDisabled="@_busy"
                OnClickButton="OnCreateAsync" />
    </div>
</aside>
