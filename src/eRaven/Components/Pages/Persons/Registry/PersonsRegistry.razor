@page "/persons"
@using eRaven.Application.DTOs
@using eRaven.Components.Pages.Persons.Registry.Drawers

<div class="page-flex">

    <RegistryToolbar OnCreateCandidate="OpenCreateCandidate" />

    @if (_loading)
    {
        <div class="page-content">
            <p class="px-3"><em>Завантаження...</em></p>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="page-content">
            <p class="px-3"><em>Записів немає.</em></p>
        </div>
    }
    else
    {
        <div class="page-content">
            <PersonsTable Items="_items"
                          Selected="_selected"
                          SelectedChanged="OnSelectedChanged"                         
                          OnOpenCard="OpenCard" 
                          OnRowClick="OnRowClick" />
        </div>

        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-top flex-shrink-0">
            <div class="small">
                Показано: @_items.Count • Сторінка @CurrentPage • Всього: @_totalCount
            </div>

            <div class="btn-group">
                <Button Class="btn-sm btn-outline-secondary"
                        Label="‹"
                        IsDisabled="@(!HasPrev)"
                        OnClickButton="PrevPage"/>

                <Button Class="btn-sm btn-outline-secondary"
                        Label="›"
                        IsDisabled="@(!HasNext)"
                        OnClickButton="NextPage" />
            </div>
        </div>
    }
</div>

<CreateCandidateDrawer IsOpen="@_createOpen"
                       IsOpenChanged="v => _createOpen = v"
                       OnCreate="HandleCreateCandidate" />
