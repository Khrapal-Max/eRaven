@page "/persons"
@using eRaven.Application.DTOs
@using eRaven.Components.Pages.Persons.Registry.Drawers

<div class="page-flex">

    <RegistryToolbar OnCreateReserved="OpenCreateReserved" />

    <div class="page-content">
        @if (_loading)
        {
            <p class="px-3"><em>Завантаження...</em></p>
        }
        else if (_pageData.Items.Count == 0)
        {
            <p class="px-3"><em>Записів немає.</em></p>
        }
        else
        {
            <PersonsTable Items="_pageData.Items"
                          Selected="@_selected"
                          SelectedChanged="@(v => _selected = v)"
                          OnRowClick="OnRowClick"
                          OnOpenCard="OpenCard"
                          OnEnroll="OpenEnroll"
                          OnExclude="OpenExclude" />
        }
    </div>

    <CreateReservedDrawer IsOpen="@_createReservedOpen"
                          IsOpenChanged="@(v => _createReservedOpen = v)"
                          OnCreate="HandleCreateReservedAsync" />

    <EnrollDrawer IsOpen="_enrollOpen"
                  IsOpenChanged="@(v => _enrollOpen = v)"
                  PersonId="_enrollPersonId"
                  OnSubmit="HandleEnrollSubmitAsync" />
</div>      