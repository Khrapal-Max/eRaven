@using Microsoft.AspNetCore.Components.Forms
@using eRaven.Application.DTOs
@using eRaven.Components.Shared.Validation
@using eRaven.Components.Shared.Drawer

<Drawer Title="Створити картку (Reserved)"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        DisableClose="@_busy"
        OnClosed="OnDrawerClosed">

    <ChildContent>
        @if (IsOpen)
        {
            <EditForm EditContext="@_editContext"
                      OnValidSubmit="OnCreateAsync"
                      id="create-reserved-form">

                <FluentValidationValidator />

                <div class="drawer-grow">
                    <h6 class="mb-3">Основні дані</h6>

                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">РНОКПП (10 цифр)</label>
                            <InputText class="form-control rounded-0" @bind-Value="Model.Rnokpp" />
                            <ValidationMessage For="@(() => Model.Rnokpp)" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">Прізвище</label>
                            <InputText class="form-control rounded-0" @bind-Value="Model.LastName" />
                            <ValidationMessage For="@(() => Model.LastName)" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">Ім’я</label>
                            <InputText class="form-control rounded-0" @bind-Value="Model.FirstName" />
                            <ValidationMessage For="@(() => Model.FirstName)" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label mb-1">По батькові (опц.)</label>
                            <InputText class="form-control rounded-0" @bind-Value="Model.MiddleName" />
                            <ValidationMessage For="@(() => Model.MiddleName)" />
                        </div>
                    </div>

                    <hr class="my-3" />

                    <h6 class="mb-3">Професійні / військові дані (опційно)</h6>

                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Звання</label>

                            <div class="dropdown w-100">
                                <button class="btn btn-outline-secondary dropdown-toggle w-100 text-truncate"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    @(string.IsNullOrWhiteSpace(Model.Rank) ? "— оберіть звання —" : Model.Rank)
                                </button>

                                <ul class="dropdown-menu border w-100 overflow-auto" style="max-height: 30vh;">
                                    @foreach (var title in _ranks)
                                    {
                                        <li>
                                            <Button Class="dropdown-item"
                                                    Label="@title.Title"
                                                    OnClickButton="() => SelectRank(title.Title)" />
                                        </li>
                                    }
                                </ul>
                            </div>

                            <ValidationMessage For="@(() => Model.Rank)" />
                        </div>

                        <div class="row g-2">
                            <div class="col-12 col-md-2">
                                <label class="form-label mb-1">Порядок посади</label>
                                <InputNumber class="form-control rounded-0" @bind-Value="Model.PositionSort" />
                                <ValidationMessage For="@(() => Model.PositionSort)" />
                            </div>

                            <div class="col-12 col-md-10">
                                <label class="form-label mb-1">Посада (опц.)</label>
                                <InputText class="form-control rounded-0" @bind-Value="Model.Position" />
                                <ValidationMessage For="@(() => Model.Position)" />
                            </div>
                        </div>
                      
                    </div>
                </div>
            </EditForm>
        }
    </ChildContent>

    <FooterContent>
        <Button Class="btn-outline-secondary rounded-0"
                Label="Скасувати"
                IsDisabled="@_busy"
                OnClickButton="OnCancel" />

        <!-- ✅ тільки submit, без @onclick -->
        <button type="submit"
                form="create-reserved-form"
                class="btn btn-primary rounded-0"
                disabled="@_busy">
            Створити
        </button>
    </FooterContent>
</Drawer>
