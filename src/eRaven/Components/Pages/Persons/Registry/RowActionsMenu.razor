<div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary rounded-0" data-bs-toggle="dropdown">
        ⋮
    </button>

    <ul class="dropdown-menu dropdown-menu-end">
        <li><button class="dropdown-item" @onclick="OnOpen">Відкрити картку</button></li>
        <li><hr class="dropdown-divider" /></li>
        <li><button class="dropdown-item">Швидка зміна звання…</button></li>
        <li><button class="dropdown-item">Швидка зміна посади…</button></li>
        <li><button class="dropdown-item">Змінити позивний…</button></li>
        <li><button class="dropdown-item">Змінити зброю…</button></li>
        <li><hr class="dropdown-divider" /></li>
        <li><button class="dropdown-item text-danger">Void останню подію…</button></li>
    </ul>
</div>

@code {
    [Parameter] public Action? OnOpen { get; set; }
}
