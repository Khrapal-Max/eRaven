@using eRaven.Domain.Enums

<div class="px-3 d-flex align-items-center flex-wrap flex-lg-nowrap gap-2 border border-secondary">

    <!-- Title -->
    <h6 class="m-0 text-nowrap flex-shrink-0">
        Реєстр особового складу
    </h6>

    <!-- Search: mobile = full width, desktop = fixed width -->
    <div class="input-group input-group-sm w-100 w-lg-auto"
         style="min-width: 220px; max-width: 300px;">
        <span class="input-group-text rounded-0 px-2">
            <i class="bi bi-search"></i>
        </span>

        <input class="form-control rounded-0 py-0"
               placeholder="ПІБ або РНОКПП"
               @bind="_searchDraft"
               @bind:event="oninput"
               @onkeydown="OnSearchKeyDown" />

        <button type="button"
                class="btn btn-outline-secondary rounded-0 py-0 px-2"
                disabled="@string.IsNullOrWhiteSpace(_searchDraft)"
                @onclick="ClearSearch">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Filters block (stays in same row on desktop) -->
    <div class="d-flex align-items-center flex-wrap flex-lg-nowrap gap-2">

        <!-- Lifecycle -->
        <div class="btn-group btn-group-sm text-nowrap" role="group" aria-label="Lifecycle filter">
            <Button Class="@BtnClass(IsLifecycle(null))"
                    Label="Усі"
                    OnClickButton="() => SetLifecycle(null)" />

            <Button Class="@BtnClass(IsLifecycle(PersonLifecycle.Reserved))"
                    Label="Резерв"
                    OnClickButton="() => SetLifecycle(PersonLifecycle.Reserved)" />

            <Button Class="@BtnClass(IsLifecycle(PersonLifecycle.Enrolled))"
                    Label="В табелі"
                    OnClickButton="() => SetLifecycle(PersonLifecycle.Enrolled)" />
        </div>

        <!-- EnrollmentKind -->
        <div class="btn-group btn-group-sm text-nowrap" role="group" aria-label="Enrollment kind filter">
            <Button Class="@BtnClass(IsKind(null))"
                    Label="Всі типи"
                    OnClickButton="() => SetKind(null)" />

            <Button Class="@BtnClass(IsKind(EnrollmentKind.Unit))"
                    Label="Штат"
                    OnClickButton="() => SetKind(EnrollmentKind.Unit)" />

            <Button Class="@BtnClass(IsKind(EnrollmentKind.AttachedByList))"
                    Label="Наказ"
                    OnClickButton="() => SetKind(EnrollmentKind.AttachedByList)" />

            <Button Class="@BtnClass(IsKind(EnrollmentKind.AttachedByOrder))"
                    Label="БР"
                    OnClickButton="() => SetKind(EnrollmentKind.AttachedByOrder)" />
        </div>

        <Button Class="btn-sm btn-outline-secondary rounded-0"
                Label="Скинути"
                IsDisabled="@(!HasAnyFilter)"
                OnClickButton="Reset" />
    </div>

    <!-- Create (pinned to right on desktop) -->
    <div class="ms-lg-auto flex-shrink-0">
        <Button Class="btn btn-sm btn-primary rounded-0"
                Label="+ Створити"
                OnClickButton="HandleCreateClick" />
    </div>
</div>
