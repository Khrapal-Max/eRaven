@using eRaven.Application.DTOs
@using eRaven.Domain.Enums
@using eRaven.Components.Shared.Table

<Table TItem="PersonRowDto"
       Items="Items"
       KeySelector="x => x.Id"
       @bind-SelectedItem="Selected"
       OnClick="OnRowClick">
    <TableHeader>
        <th>ПІБ</th>
        <th>РНОКПП</th>
        <th>Статус</th>
        <th>Звання</th>
        <th>Посади</th>
        <th>Оновлено</th>
        <th class="text-end" style="width:1%"></th>
    </TableHeader>

    <RowTemplate Context="p">
        <td class="text-truncate">@p.FullName</td>
        <td>@p.Rnokpp</td>
        <td>@LifecycleBadge(p.Lifecycle)</td>
        <td>@(p.Rank ?? "—")</td>

        <td>
            @if (p.Lifecycle == PersonLifecycle.Candidate)
            {
                <div class="small">
                    <span>Резерв:</span>
                    <span>@(string.IsNullOrWhiteSpace(p.PlannedPosition) ? "—" : p.PlannedPosition)</span>
                </div>
            }
            else
            {
                <div class="small">
                    <span>Осн:</span>
                    <span>@(string.IsNullOrWhiteSpace(p.Position) ? "—" : p.Position)</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(p.TemporaryPosition))
                {
                    <div class="small">
                        <span>ТВО:</span>
                        <span>@p.TemporaryPosition</span>
                    </div>
                }

                @* якщо хочеш показувати “резерв” і для діючих — розкоментуй *@
                @*
                @if (!string.IsNullOrWhiteSpace(p.PlannedPosition))
                {
                    <div class="small">
                        <span class="text-muted">Резерв:</span>
                        <span>@p.PlannedPosition</span>
                    </div>
                }
                *@
            }
        </td>

        <td class="text-nowrap">@p.UpdatedAtUtc.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>

        <td class="text-end">
            <div class="dropdown">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        title="Дії"
                        @onclick:stopPropagation="true">
                    ⋯
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button type="button" class="dropdown-item"
                                @onclick="() => OpenCard(p)"
                                @onclick:stopPropagation="true">
                            Відкрити картку
                        </button>
                    </li>

                    <li><hr class="dropdown-divider" /></li>

                    <li>
                        <button type="button" class="dropdown-item" disabled
                                @onclick:stopPropagation="true">
                            Змінити звання (чернетка)
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" disabled
                                @onclick:stopPropagation="true">
                            Змінити посаду (чернетка)
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" disabled
                                @onclick:stopPropagation="true">
                            Змінити ТВО (чернетка)
                        </button>
                    </li>

                    <li><hr class="dropdown-divider" /></li>

                    <li>
                        <button type="button" class="dropdown-item text-danger" disabled
                                @onclick:stopPropagation="true">
                            Виключити (чернетка)
                        </button>
                    </li>
                </ul>
            </div>
        </td>
    </RowTemplate>
</Table>
