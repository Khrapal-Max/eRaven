@inject NavigationManager Nav

<tr>
    <td>
        <span class="badge text-bg-success rounded-pill">●</span>
    </td>

    <td role="button" @onclick="OpenCard">
        <div class="fw-semibold">@FullName</div>
        <small class="text-muted">RNOKPP: 1234567890 • Callsign: -</small>
    </td>

    <td>@Rank</td>
    <td>@Position</td>

    <td>
        <span class="badge text-bg-light border text-muted">@Kind</span>
    </td>

    <td class="text-end">
        <RowActionsMenu OnOpen="OpenCard" />
    </td>
</tr>

@code {
    [Parameter] public string FullName { get; set; } = "";
    [Parameter] public string? Rank { get; set; }
    [Parameter] public string? Position { get; set; }
    [Parameter] public string Kind { get; set; } = "Unit";

    private void OpenCard()
    {
        // stub: "fake" id so routing works visually
        var fakeId = Guid.NewGuid();
        Nav.NavigateTo($"/persons/{fakeId}");
    }
}
