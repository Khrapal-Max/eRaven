@page "/task-documents"

@using eRaven.Application.DTOs.CombatTask
@using eRaven.Domain.Enums

<PageTitle>Планування (документи)</PageTitle>

<div class="page-content">
    <div class="border bg-secondary-subtle">
        <div class="py-2 px-4 text-white">
            Документи (планування)
        </div>
    </div>

    <div class="container-fluid px-3 py-3">

        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">

            <div class="d-flex flex-column">
                <label class="form-label mb-1">Місяць</label>
                <input class="form-control form-control-sm rounded-0 bg-dark text-white"
                       type="month"
                       value="@_monthIso"
                       @onchange="OnMonthChanged" />
            </div>

            <div class="d-flex flex-column">
                <label class="form-label mb-1">Статус</label>
                <select class="form-select form-select-sm rounded-0"
                        value="@_statusRaw"
                        @onchange="OnStatusChanged">
                    <option value="">Всі</option>
                    <option value="@DocumentStatus.Active">Діючий</option>
                    <option value="@DocumentStatus.Canceled">Відмінений</option>
                </select>
            </div>

            <div class="flex-grow-1 d-flex flex-column">
                <label class="form-label mb-1">Пошук (назва документа)</label>
                <input class="form-control form-control-sm rounded-0"
                       value="@_search"
                       @oninput="OnSearchInput"
                       placeholder="Напр: План №12" />
            </div>

            <Button Class="btn-sm btn-primary rounded-0"
                    Label=" + Документ"
                    IsDisabled="@_loading"
                    OnClickButton="OpenCreateDraft" />

            <Button Class="btn-sm btn-outline-secondary rounded-0"
                    IsDisabled="@_loading"
                    OnClickButton="ReloadAsync">
                <span class="d-inline-flex align-items-center gap-1">
                    <span aria-hidden="true">⟳</span>
                    Оновити
                </span>
            </Button>
        </div>

        @if (_loading)
        {
            <p class="px-1"><em>Завантаження...</em></p>
        }
        else
        {
            <div class="border">
                <Table TItem="CombatTaskDocumentDto"
                       Items="@(_task ?? [])"
                       Class="table-sm table-bordered mb-0"
                       @bind-SelectedItem="_selected"
                       KeySelector="@(r => r.DocumentId)">

                    <TableHeader>
                        <th class="text-center">Дата</th>
                        <th>№ розпорядження</th>
                        <th>Опис змісту</th>
                        <th class="text-center">Статус</th>
                        <th class="text-center">Дії</th>
                    </TableHeader>

                    <RowTemplate Context="r">
                        <td class="text-center">@r.RecordedAt.ToString("dd.MM.yyyy")</td>
                        <td>@r.OrderTitle</td>
                        <td>@r.Description</td>
                        <td class="text-center">@StatusText(r.Status)</td>
                        <td class="text-center">
                            <Button Class="btn-sm btn-success rounded-0"
                                    Label="Відкрити"
                                    OnClickButton="@(() => Nav.NavigateTo($"/task-document/{@r.DocumentId}"))" />
                        </td>
                    </RowTemplate>
                </Table>
            </div>
        }

        <!-- Drawer create draft -->
        <CreateDocumentDrawer IsOpen="_createDraftOpen"
                              IsOpenChanged="@(v => _createDraftOpen = v)"
                              OnCreated="HandleDraftCreated" />
    </div>
</div>       