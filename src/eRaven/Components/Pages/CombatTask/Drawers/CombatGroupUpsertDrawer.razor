@using eRaven.Domain.Enums

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        Title="@(Mode == "create" ? "Додати місію" : "Редагувати місію")">

    <div class="p-2">
        <div class="mb-2">
            <label class="form-label small">Джерело (номер документа A / рапорт)</label>
            <input class="form-control form-control-sm rounded-0"
                   @bind="_sourceDocNo" />
        </div>

        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small">Дія</label>
                <select class="form-select form-select-sm rounded-0" @bind="_action">
                    <option value="@ActionKind.Start">Почати виконання</option>
                    <option value="@ActionKind.End">Закінчити виконання</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small">Дата</label>
                <input type="date"
                       class="form-control form-control-sm rounded-0 bg-dark text-white"
                       @bind="_actionDate" />
            </div>
        </div>

        <div class="mb-2">
            <label class="form-label small">Місія</label>

            <select class="form-select form-select-sm rounded-0" @bind="_missionId">
                <option value="">— обери —</option>
                @foreach (var m in _missions)
                {
                    <option value="@m.Id">@m.Display</option>
                }
            </select>

            @if (!string.IsNullOrWhiteSpace(_missionDisplay))
            {
                <div class="small mt-1">@_missionDisplay</div>
            }
        </div>

        @if (Mode == "create")
        {
            <div class="mt-3 border-top pt-2">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="fw-semibold">Особи</div>
                    <div class="small">(@_selected.Count)</div>
                </div>

                <input class="form-control form-control-sm rounded-0 mb-2"
                       placeholder="Пошук..."
                       @bind="_search"
                       @bind:event="oninput" />

                <div class="border" style="max-height: 260px; overflow:auto;">
                    @if (_persons.Count == 0)
                    {
                        <div class="p-2 small"><em>Немає результатів.</em></div>
                    }
                    else
                    {
                        @foreach (var p in _persons)
                        {
                            <label class="d-flex gap-2 align-items-center p-2 border-bottom small">
                                <input type="checkbox"
                                       checked="@_selected.Contains(p.Id)"
                                       @onchange="(e => TogglePerson(p.Id, (bool)e.Value!))" />

                                <span class="text-truncate">
                                    @p.Display
                                </span>
                            </label>
                        }
                    }
                </div>
            </div>
        }

        <div class="d-flex gap-2 mt-3">
            <Button Class="btn-sm btn-danger rounded-0"
                    Label="Закрити"
                    OnClickButton="Close" />

            <Button Class="btn-sm btn-success rounded-0"
                    Label="Зберегти"
                    IsDisabled="@(!CanSave)"
                    OnClickButton="Save" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="text-danger small mt-2">@_error</div>
        }
    </div>
</Drawer>