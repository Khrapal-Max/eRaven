@using eRaven.Domain.Enums

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        Title="@(Mode == "create" ? "Додати місію" : "Редагувати місію")">

    <div class="p-2">

        <!-- Source -->
        <div class="mb-2">
            <label class="form-label small">Джерело (номер документа A / рапорт)</label>
            <input class="form-control form-control-sm rounded-0"
                   @bind="_sourceDocNo" />
        </div>

        <!-- Action + Date -->
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small">Дія</label>
                <select class="form-select form-select-sm rounded-0" @bind="_action">
                    <option value="@ActionKind.Start">Почати виконання</option>
                    <option value="@ActionKind.End">Закінчити виконання</option>
                </select>
            </div>

            <div class="col-6">
                <label class="form-label small">Дата</label>
                <input type="date"
                       class="form-control form-control-sm rounded-0"
                       @bind="_actionDate" />
            </div>
        </div>

        <!-- Mission Picker (без select) -->
        <div class="mb-2">
            <label class="form-label small">Місія</label>

            <input class="form-control form-control-sm rounded-0 mb-2"
                   placeholder="Пошук місії..."
                   @bind="_missionSearch"
                   @oninput="OnMissionSearchInput" />

            <div class="border" style="max-height: 220px; overflow:auto;">
                @if (_missionsFiltered.Count == 0)
                {
                    <div class="p-2 small"><em>Немає результатів.</em></div>
                }
                else
                {
                    @foreach (var m in _missionsFiltered)
                    {
                        <button type="button"
                                class="btn btn-sm w-100 text-start rounded-0 border-bottom"
                                @onclick="@(() => SelectMission(m))">
                            <div style="white-space: normal; overflow-wrap:anywhere;">
                                @m.DisplayMisssion
                            </div>
                        </button>
                    }
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_missionDisplay))
            {
                <div class="mt-2 p-2 border bg-light">
                    <div class="small">Обрана місія</div>
                    <div class="small" style="white-space: normal; overflow-wrap:anywhere;">
                        @_missionDisplay
                    </div>
                </div>
            }
        </div>

        <!-- Persons (тільки Create) -->
        @if (Mode == "create")
        {
            <div class="mt-3 border-top pt-2">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="fw-semibold">Особи</div>
                    <div class="small">(@_selected.Count)</div>
                </div>

                <input class="form-control form-control-sm rounded-0 mb-2"
                       placeholder="Пошук (мін. 2 символи): ПІБ / РНОКПП / позивний..."
                       @bind="_personSearch"
                       @oninput="@OnPersonSearchInput" />

                <div class="border" style="max-height: 280px; overflow:auto;">
                    @if (_personResults.Count == 0)
                    {
                        <div class="p-2 small"><em>Введи пошук для вибору осіб.</em></div>
                    }
                    else
                    {
                        @foreach (var p in _personResults)
                        {
                            <label class="d-flex gap-2 align-items-start p-2 border-bottom small">
                                <input type="checkbox"
                                       class="mt-1"
                                       checked="@_selected.Contains(p.PersonId)"
                                       @onchange="(e => TogglePerson(p.PersonId, (bool)e.Value!))" />

                                <div class="min-w-0">
                                    <div class="fw-semibold text-truncate">@p.FullName</div>
                                    <div style="white-space: normal; overflow-wrap:anywhere;">
                                        РНОКПП: <span class="font-monospace">@p.RNOKPP</span>
                                        · @p.Rank
                                        · @p.Position
                                        @if (!string.IsNullOrWhiteSpace(p.Weapon))
                                        {
                                            <span> · @p.Weapon</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.Callsign))
                                        {
                                            <span> · @p.Callsign</span>
                                        }
                                    </div>
                                </div>
                            </label>
                        }
                    }
                </div>
            </div>
        }

        <!-- Buttons -->
        <div class="d-flex gap-2 mt-3">
            <Button Class="btn-sm btn-danger rounded-0"
                    Label="Закрити"
                    OnClickButton="Close" />

            <Button Class="btn-sm btn-success rounded-0"
                    Label="Зберегти"
                    IsDisabled="@(!CanSave)"
                    OnClickButton="Save" />
        </div>
    </div>
</Drawer>
