@using eRaven.Application.DTOs.CombatTask

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        Title="Назначити завдання">

    <div class="p-2">

        <!-- ========================================================= -->
        <!-- Meta: Source + From -->
        <!-- ========================================================= -->
        <div class="row g-2 mb-2">
            <div class="col-4 col-lg-4">
                <label class="form-label small">Джерело (номер документа / рапорт)</label>
                <input class="form-control form-control-sm rounded-0"
                       @bind-value="_model.SourceDocument" />
            </div>

            <div class="col-4 col-lg-4">
                <label class="form-label small">Дата початку (From)</label>
                <input type="date"
                       class="form-control form-control-sm rounded-0"
                       @bind-value="_from"
                       @bind-value:after="OnFromChangedAsync" />
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- Mission picker -->
        <!-- ========================================================= -->
        <div class="mb-2">
            <label class="form-label small">Місія</label>

            <div class="border">
                <select class="form-select form-select-sm rounded-0"
                        size="4"
                        value="@_model.MissionId"
                        @onchange="OnMissionChanged">

                    @if (_missionsLoading)
                    {
                        <option disabled>Завантаження...</option>
                    }
                    else if (_missionOptions.Count == 0)
                    {
                        <option disabled>Немає місій.</option>
                    }
                    else
                    {
                        @foreach (var g in MissionGroups)
                        {
                            <optgroup label="@GetMissionGroupLabel(g.Mode, g.Count)">
                                @foreach (var m in g.Items)
                                {
                                    <option value="@m.MissionId">@FormatMissionOption(m)</option>
                                }
                            </optgroup>
                        }
                    }
                </select>
            </div>

            @if (!string.IsNullOrWhiteSpace(_missionDisplay))
            {
                <div class="mt-2 p-2 border">
                    <div class="d-flex align-items-center gap-2">
                        <div class="small me-auto">Обрана місія</div>

                        <Button Class="btn-sm btn-warning rounded-0"
                                Label="Очистити"
                                OnClickButton="ClearMission" />
                    </div>

                    <div class="small mt-1" style="white-space: normal; overflow-wrap:anywhere;">
                        @_missionDisplay
                    </div>
                </div>
            }
        </div>

        <!-- ========================================================= -->
        <!-- Persons -->
        <!-- ========================================================= -->
        <div class="mt-3 border-top pt-2">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="fw-semibold">Особи</div>
                <div class="small">(@_selected.Count)</div>
                <div class="small ms-auto">
                    @if (_personsLoading)
                    {
                        <span><em>Завантаження...</em></span>
                    }
                    else
                    {
                        <span>@_personResults.Count / @_personsAll.Count</span>
                    }
                </div>
            </div>

            <input class="form-control form-control-sm rounded-0 mb-2"
                   placeholder="Пошук (мін. 2 символи): ПІБ / РНОКПП / позивний..."
                   @bind-value="_personSearch"
                   @bind-value:event="oninput"
                   @bind-value:after="OnPersonSearchAfterBindingAsync" />

            <div class="border" style="max-height: 180px; overflow:auto;">
                @if (_personResults.Count == 0)
                {
                    <div class="p-2 small">
                        <em>@PersonsEmptyHint</em>
                    </div>
                }
                else
                {
                    <Table TItem="ReadyCombatTaskPersonDto"
                           Items="@_personResults"
                           Class="table-sm table-bordered small mb-0">

                        <TableHeader>
                            <th style="width: 32px;"></th>
                            <th style="width:120px;">РНОКПП</th>
                            <th>ПІБ</th>
                            <th style="width:120px;">Позивний</th>
                        </TableHeader>

                        <RowTemplate Context="r">
                            <td>
                                <input type="checkbox"
                                       checked="@_selected.ContainsKey(r.PersonId)"
                                       @onchange="(e => TogglePerson(r, e))" />
                            </td>
                            <td class="font-monospace text-nowrap">@r.Rnokpp</td>
                            <td style="white-space: normal; overflow-wrap:anywhere;">@r.FullName</td>
                            <td>@r.Callsign</td>
                        </RowTemplate>
                    </Table>
                }
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- Buttons -->
        <!-- ========================================================= -->
        <div class="d-flex gap-2 mt-3">
            <Button Class="btn-sm btn-danger rounded-0"
                    Label="Закрити"
                    OnClickButton="Close" />

            <Button Class="btn-sm btn-success rounded-0"
                    Label="Зберегти"
                    IsDisabled="@(!CanSave)"
                    OnClickButton="Save" />
        </div>

    </div>
</Drawer>
