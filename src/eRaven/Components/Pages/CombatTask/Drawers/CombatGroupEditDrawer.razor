@using eRaven.Application.DTOs.CombatTask
@using eRaven.Domain.Enums

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        Title="Редагувати місію">

    <div class="p-2">

        <!-- ========================================================= -->
        <!-- Source + Action + Date -->
        <!-- ========================================================= -->
        <div class="row g-2 mb-2">
            <div class="col-4">
                <label class="form-label small">Джерело (номер документа A / рапорт)</label>
                <input class="form-control form-control-sm rounded-0"
                       @bind-value="_sourceDocNo" />
            </div>

            <div class="col-4">
                <label class="form-label small">Дія</label>
                <select class="form-select form-select-sm rounded-0"
                        @bind="_action">
                    <option value="@ActionKind.Start">Почати виконання</option>
                    <option value="@ActionKind.End">Закінчити виконання</option>
                </select>
            </div>

            <div class="col-4">
                <label class="form-label small">Дата</label>
                <input type="date"
                       class="form-control form-control-sm rounded-0"
                       @bind-value="_actionDate" />
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- Mission picker -->
        <!-- ========================================================= -->
        <div class="mb-2">
            <label class="form-label small">Місія</label>

            <div class="border">
                <select class="form-select form-select-sm rounded-0"
                        size="4"
                        value="@_missionId"
                        @onchange="OnMissionChanged">

                    @* fallback: якщо місії немає у _missionOptions (закрита/видалена) *@
                    @if (_missionId != Guid.Empty && !_missionOptions.Any(x => x.MissionId == _missionId))
                    {
                        <option value="@_missionId">@_missionDisplay</option>
                    }

                    @if (_missionsLoading)
                    {
                        <option disabled>Завантаження...</option>
                    }
                    else if (_missionOptions.Count == 0)
                    {
                        <option disabled>Немає місій.</option>
                    }
                    else
                    {
                        @foreach (var g in MissionGroups)
                        {
                            <optgroup label="@GetMissionGroupLabel(g.Mode, g.Count)">
                                @foreach (var m in g.Items)
                                {
                                    <option value="@m.MissionId">@FormatMissionOption(m)</option>
                                }
                            </optgroup>
                        }
                    }
                </select>
            </div>

            @if (!string.IsNullOrWhiteSpace(_missionDisplay))
            {
                <div class="mt-2 p-2 border">
                    <div class="d-flex align-items-center gap-2">
                        <div class="small me-auto">Обрана місія</div>

                        <Button Class="btn-sm btn-outline-secondary rounded-0"
                                Label="Очистити"
                                OnClickButton="ClearMission" />
                    </div>

                    <div class="small mt-1" style="white-space: normal; overflow-wrap:anywhere;">
                        @_missionDisplay
                    </div>
                </div>
            }
        </div>

        <!-- ========================================================= -->
        <!-- Buttons -->
        <!-- ========================================================= -->
        <div class="d-flex gap-2 mt-3">
            <Button Class="btn-sm btn-danger rounded-0"
                    Label="Закрити"
                    OnClickButton="Close" />

            <Button Class="btn-sm btn-success rounded-0"
                    Label="Зберегти"
                    IsDisabled="@(!CanSave)"
                    OnClickButton="Save" />
        </div>

    </div>
</Drawer>
