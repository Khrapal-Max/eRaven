@* @using eRaven.Application.DTOs.CombatTask

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        Title="Закрити участь у місії">

    <div class="p-2">

        <!-- ========================================================= -->
        <!-- Meta: To + EndSourceDocNo -->
        <!-- ========================================================= -->
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small">Дата завершення (To)</label>
                <input type="date"
                       class="form-control form-control-sm rounded-0"
                       @bind-value="_to"
                       @bind-value:after="OnToChangedAsync" />
            </div>

            <div class="col-6">
                <label class="form-label small">№ документа закриття</label>
                <input class="form-control form-control-sm rounded-0"
                       @bind-value="_endSourceDocNo" />
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- Stage 1: Mission select -->
        <!-- ========================================================= -->
        @if (!_missionSelected)
        {
            <div class="border-top pt-2">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="fw-semibold">Місія</div>
                    <div class="small text-muted">(активні на дату)</div>
                </div>

                <input class="form-control form-control-sm rounded-0 mb-2"
                       placeholder="Пошук місії (мін. 2 символи)…"
                       @bind-value="_missionSearch"
                       @bind-value:event="oninput"
                       @bind-value:after="OnMissionSearchAfterBindingAsync" />

                <div class="border" style="max-height: 220px; overflow:auto;">
                    @if (_missionsLoading)
                    {
                        <div class="p-2 small"><em>Завантаження...</em></div>
                    }
                    else if (_missions.Count == 0)
                    {
                        <div class="p-2 small"><em>Немає активних місій на цю дату.</em></div>
                    }
                    else
                    {
                        <Table TItem="ActiveMissionOptionDto"
                               Items="_missions"
                               IsClickable="false"
                               Class="table-sm table-bordered small mb-0">

                            <TableHeader>
                                <th style="width:32px;"></th>
                                <th>Місія</th>
                                <th style="width:110px;">Активних</th>
                            </TableHeader>

                            <RowTemplate Context="m">
                                <td>
                                    <input type="radio"
                                           name="mission"
                                           checked="@(_missionId == m.MissionId)"
                                           @onchange="@(_ => SelectMission(m))" />
                                </td>
                                <td style="white-space: normal; overflow-wrap:anywhere;">
                                    @m.MissionDisplaySnapshot
                                </td>
                                <td class="text-center">@m.ActivePersonsCount</td>
                            </RowTemplate>
                        </Table>
                    }
                </div>

                <div class="d-flex gap-2 mt-3">
                    <Button Class="btn-sm btn-outline-secondary rounded-0"
                            Label="Закрити"
                            OnClickButton="Close" />

                    <Button Class="btn-sm btn-primary rounded-0"
                            Label="Далі → Особи"
                            IsDisabled="@(_missionId == Guid.Empty)"
                            OnClickButton="GoToPersonsStage" />
                </div>
            </div>
        }
        else
        {
            <!-- ========================================================= -->
            <!-- Stage 2: Persons select -->
            <!-- ========================================================= -->
            <div class="border-top pt-2">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="fw-semibold">Особи</div>
                    <div class="small text-muted">(@_selected.Count)</div>

                    <div class="ms-auto">
                        <Button Class="btn-sm btn-outline-secondary rounded-0"
                                Label="← Змінити місію"
                                OnClickButton="BackToMissionsStage" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_missionDisplay))
                {
                    <div class="border p-2 mb-2 small bg-white"
                         style="white-space: normal; overflow-wrap:anywhere;">
                        @_missionDisplay
                    </div>
                }

                <input class="form-control form-control-sm rounded-0 mb-2"
                       placeholder="Пошук (мін. 2 символи): ПІБ / РНОКПП / позивний…"
                       @bind-value="_personSearch"
                       @bind-value:event="oninput"
                       @bind-value:after="OnPersonSearchAfterBindingAsync" />

                <div class="border" style="max-height: 260px; overflow:auto;">
                    @if (_personsLoading)
                    {
                        <div class="p-2 small"><em>Завантаження...</em></div>
                    }
                    else if (_persons.Count == 0)
                    {
                        <div class="p-2 small"><em>Немає активних осіб у місії на цю дату.</em></div>
                    }
                    else
                    {
                        <Table TItem="CombatTaskPersonLookupDto"
                               Items="_persons"
                               IsClickable="false"
                               Class="table-sm table-bordered small mb-0">

                            <TableHeader>
                                <th style="width: 32px;"></th>
                                <th>ПІБ</th>
                                <th>РНОКПП</th>
                                <th>Звання</th>
                                <th>Посада</th>
                                <th>Зброя</th>
                                <th>Позивний</th>
                            </TableHeader>

                            <RowTemplate Context="p">
                                <td>
                                    <input type="checkbox"
                                           checked="@_selected.ContainsKey(p.PersonId)"
                                           @onchange="(e => TogglePerson(p, e))" />
                                </td>
                                <td>@p.FullName</td>
                                <td class="font-monospace text-nowrap">@p.RNOKPP</td>
                                <td>@p.Rank</td>
                                <td style="white-space: normal; overflow-wrap:anywhere;">@p.Position</td>
                                <td>@p.Weapon</td>
                                <td>@p.Callsign</td>
                            </RowTemplate>
                        </Table>
                    }
                </div>

                <div class="d-flex gap-2 mt-3">
                    <Button Class="btn-sm btn-outline-secondary rounded-0"
                            Label="Закрити"
                            OnClickButton="Close" />

                    <Button Class="btn-sm btn-dark rounded-0"
                            Label="Завершити"
                            IsDisabled="@(!CanSave)"
                            OnClickButton="Save" />
                </div>
            </div>
        }

    </div>
</Drawer>
 *@