@using eRaven.Application.DTOs.CombatTask

<Drawer IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        Title="Закрити групу участей">

    <div class="p-2">

        @if (Group is null)
        {
            <div class="small"><em>Немає даних по групі.</em></div>
        }
        else
        {
            <div class="border p-2 bg-white mb-2">
                <div class="small font-monospace">#@Group.GroupSequence</div>
                <div class="fw-semibold">@Group.MissionDisplay</div>
                <div class="small">Початок: <span class="font-monospace">@Group.From.ToString("dd.MM.yyyy")</span></div>
            </div>

            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label small">Дата завершення (To)</label>
                    <input type="date"
                           class="form-control form-control-sm rounded-0"
                           @bind-value="_to" />
                </div>

                <div class="col-6">
                    <label class="form-label small">№ документа закриття</label>
                    <input class="form-control form-control-sm rounded-0"
                           @bind-value="_endSourceDocNo" />
                </div>
            </div>
        }

        <div class="d-flex gap-2 mt-3">
            <Button Class="btn-sm btn-outline-secondary rounded-0"
                    Label="Закрити"
                    OnClickButton="Close" />

            <Button Class="btn-sm btn-dark rounded-0"
                    Label="Підтвердити"
                    IsDisabled="@(!CanSave)"
                    OnClickButton="Save" />
        </div>

    </div>
</Drawer>
