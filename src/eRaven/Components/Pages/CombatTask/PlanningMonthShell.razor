@page "/planning"
@using eRaven.Application.DTOs.CombatTask

<PageTitle>Планування (місяць)</PageTitle>

<div class="page-content">
    <div class="container-fluid px-3 py-3">

        <div class="border bg-secondary-subtle mb-3">
            <div class="py-2 px-4 text-white">
                Планування (місяць)
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">

            <div class="d-flex flex-column">
                <label class="form-label mb-1">Місяць</label>
                <input class="form-control form-control-sm rounded-0 bg-dark text-white"
                       type="month"
                       value="@_monthIso"
                       @onchange="OnMonthChanged" />
            </div>

            <div class="flex-grow-1 d-flex flex-column">
                <label class="form-label mb-1">Пошук (ПІБ або РНОКПП)</label>
                <input class="form-control form-control-sm rounded-0"
                       value="@_search"
                       @oninput="OnSearchInput"
                       placeholder="Напр: Іванов або 1234567890" />
            </div>

            <Button Class="btn-sm btn-outline-secondary rounded-0"
                    IsDisabled="@_loading"
                    OnClickButton="ReloadAsync">
                <span class="d-inline-flex align-items-center gap-1">
                    <span aria-hidden="true">⟳</span>
                    Оновити
                </span>
            </Button>

            <Button Class="btn-sm btn-outline-secondary rounded-0"
                    Label="День"
                    OnClickButton="@(() => Nav.NavigateTo("/planning-day"))" />

            <Button Class="btn-sm btn-outline-secondary rounded-0"
                    Label="Документи"
                    OnClickButton="@(() => Nav.NavigateTo("/planning-documents"))" />
        </div>

        @if (_loading)
        {
            <p class="px-1"><em>Завантаження...</em></p>
        }
        else if (_error is not null)
        {
            <div class="alert alert-danger rounded-0">@_error</div>
        }
        else
        {
            <div class="small mb-2">
                Місяць: <strong>@_year-@_month.ToString("00")</strong>
                · Рядків: <strong>@(_rows?.Count ?? 0)</strong>
            </div>

            <div class="border">
                <Table TItem="PlanningMonthAssignmentRowDto"
                       Items="@(_rows ?? [])"
                       Class="table-sm table-bordered mb-0"
                       @bind-SelectedItem="_selected"
                       KeySelector="@(r => r.AssignmentId)">

                    <TableHeader>
                        <th>ПІБ</th>
                        <th class="text-center">Код</th>
                        <th>Район</th>
                        <th>Група</th>
                        <th class="text-center">З</th>
                        <th class="text-center">По</th>
                        <th>Документ</th>
                        <th class="text-center">Статус</th>
                    </TableHeader>

                    <RowTemplate Context="r">
                        <td class="min-w-0">
                            <div class="fw-semibold text-truncate">@r.FullName</div>
                            <div class="small text-truncate">
                                РНОКПП: <span class="font-monospace">@r.RNOKPP</span>
                            </div>
                            <div class="small text-truncate">
                                @(r.Rank ?? "-") · @(r.Position ?? "-")
                            </div>
                        </td>

                        <td class="text-center font-monospace">100</td>
                        <td class="text-truncate">@r.PositionalArea</td>
                        <td class="text-truncate">@r.GroupName</td>

                        <td class="text-center font-monospace">@r.StartDate.ToString("dd.MM")</td>
                        <td class="text-center font-monospace">@((r.EndDate?.ToString("dd.MM")) ?? "∞")</td>

                        <td class="text-truncate">@r.PlanningDocTitle</td>
                        <td class="text-center">@StatusText(r.DocumentStatus)</td>
                    </RowTemplate>
                </Table>
            </div>
        }
    </div>
</div>
