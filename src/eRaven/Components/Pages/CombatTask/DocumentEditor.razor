@page "/task-document/{DocumentId:guid}"
@using eRaven.Domain.Enums
@using eRaven.Application.DTOs.CombatTask

<PageTitle>Документ планування</PageTitle>

<div class="page-content">
    <div class="container-fluid px-3 py-3">

        <div class="d-flex align-items-center gap-2 mb-3">
            <Button Class="btn-sm btn-outline-secondary rounded-0"
                    Label="← Назад"
                    OnClickButton="@(() => Nav.NavigateTo("/task-documents"))" />

            <Button Class="btn-sm btn-primary rounded-0"
                    Label="+ Завдання групи"
                    IsDisabled="@(_loading || !IsDraft)"
                    OnClickButton="OpenCreateDrawer" />
        </div>

        @if (_loading)
        {
            <p class="px-2"><em>Завантаження...</em></p>
        }
        else if (_doc is null)
        {
            <p class="px-2"><em>Документ не знайдено.</em></p>
        }
        else
        {
            <div class="border p-2 mb-3">
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <div>
                        <div class="small">Дата</div>
                        <div class="font-monospace fs-semibold">@_doc.RecordedAt.ToString("dd.MM.yyyy")</div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="small">Наказ</div>
                        <div class="fw-semibold">@_doc.OrderTitle</div>
                    </div>
                    <div>
                        <div class="small">Статус</div>
                        <div class="font-monospace fs-semibold">@_doc.Status</div>
                    </div>
                </div>
            </div>

            @if (_entries.Count == 0)
            {
                <div class="border p-2"><em>Місій поки немає.</em></div>
            }
            else
            {
                @foreach (var g in _entries)
                {
                    <div class="border p-2 mb-2">
                        <div class="d-flex align-items-start gap-2">
                            <div class="small font-monospace">#@g.GroupSequence</div>

                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold text-truncate">
                                    @g.Action (@g.ActionDate.ToString("dd.MM.yyyy")) — @g.MissionDisplay
                                </div>
                                <div class="small text-truncate">
                                    Джерело: @g.SourceDocNo
                                </div>
                            </div>

                            @if (IsDraft)
                            {
                                <div class="d-flex gap-2">
                                    <Button Class="btn-sm btn-outline-secondary rounded-0"
                                            Label="Ред."
                                            IsDisabled="_loading"
                                            OnClickButton="@(() => OpenEditGroupDrawer(g))" />

                                    <Button Class="btn-sm btn-outline-secondary rounded-0"
                                            Label="Особи"
                                            IsDisabled="_loading"
                                            OnClickButton="@(() => OpenPersonsDrawer(g))" />

                                    <Button Class="btn-sm btn-outline-danger rounded-0"
                                            Label="Вид."
                                            IsDisabled="_loading"
                                            OnClickButton="@(() => DeleteGroupAsync(g.GroupId))" />
                                </div>
                            }
                        </div>

                        <div class="mt-2">
                            @if (g.Persons.Count == 0)
                            {
                                <div class="small"><em>Осіб немає.</em></div>
                            }
                            else
                            {
                                <div class="small">
                                    @foreach (var p in g.Persons)
                                    {
                                        <div class="text-truncate">
                                            @p.FullName — @p.Rank — @p.Position @(!string.IsNullOrWhiteSpace(p.Callsign) ? $" ({p.Callsign})" : "")
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }

        <!-- Drawer: Create -->
        <CombatGroupUpsertDrawer IsOpen="@_createOpen"
                                 IsOpenChanged="@(v => _createOpen = v)"
                                 Mode="create"
                                 OnCreated="HandleCreatedAsync" />

        <!-- Drawer: Edit group meta -->
        <CombatGroupUpsertDrawer IsOpen="@_editOpen"
                                 IsOpenChanged="@(v => _editOpen = v)"
                                 Mode="edit"
                                 GroupId="@_activeGroupId"
                                 Initial="@_editInitial"
                                 OnUpdated="HandleUpdatedAsync" />

        <!-- Drawer: Replace persons -->
        <CombatGroupPersonsDrawer IsOpen="@_personsOpen"
                                  IsOpenChanged="@(v => _personsOpen = v)"
                                  GroupId="@_activeGroupId"
                                  InitialPersonIds="@_personsInitial"
                                  OnSaved="HandlePersonsSavedAsync" />

    </div>
</div>
