@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <NavBar />
    </header>

    <main class="app-main">
        <div class="page-container">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="container py-4">
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>
                                Сталася неочікувана помилка. <a class="alert-link" href=".">Оновити сторінку</a>
                            </div>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>
</div>
